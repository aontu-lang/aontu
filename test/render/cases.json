        {
          "args": [
            "--check",
            "{dir}/gen.aontu",
            "{dir}/build"
          ],
          "code": 0,
          "out": "",
          "err": ""
        },
        {
          "edit": {
            "build/a.txt": "edited\n"
          },
          "remove": [
            "build/sub/b.txt"
          ]
        },
        {
          "args": [
            "--check",
            "{dir}/gen.aontu",
            "{dir}/build"
          ],
          "code": 1,
          "out": "content: a.txt\nmissing: sub/b.txt\n",
          "err": ""
        }
      ],
      "after": {
        "build/a.txt": "edited\n"
      }
    },
