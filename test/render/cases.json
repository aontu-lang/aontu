      },
      "steps": [
        {
          "args": [
            "{dir}/gen.aontu",
            "{dir}/build"
          ],
          "code": 0,
          "out": "",
          "err": ""
        }
      ],
      "after": {
        "build/a.txt": "a\n",
        "build/sub/b.txt": "b1\nb2\n"
      }
    },
    {
      "name": "check-is-clean-then-names-every-drift",
      "files": {
        "gen.aontu": "out: [file(\"a.txt\", [\"a\"]) folder(\"sub\", [file(\"b.txt\", [\"b1\" \"b2\"])])]\n"
      },
      "steps": [
        {
          "args": [
