# views.aon --- the human pages, in canonical aontu.
#
# THE ONE GENERATOR THAT IS NOT IN THE TEMPLATE SURFACE, and the reason
# is a limit worth stating: ERB's only comment is `<%# ... %>`, a
# delimited form whose closer is `%>`, and the surface's block marker
# is fixed to the C family --- it opens `/*-` and closes `*/`. There is
# no marker an ERB file can carry that ERB itself ignores, so a
# generator written as an `.html.erb` file could not stay valid in its
# own language, which is the whole promise. It is canonical aontu.
#
# THE LINES COME FROM AN INNER DISPATCH, as they do in every generator
# here, and for a reason worth stating too: `replace` reaches the lines
# a rule wrote, and a unit map's `decls[].n` is two levels below the
# rule's body -- not a literal spot, so nothing in it would be
# substituted and every key would be `replace_unused`. The outer rule
# shapes the units; the inner one writes their lines.

@"../model.aon"

out: emit($.entity, [
  # --- an entity that nothing owns -----------------------------------
  {
    match: root: true
    body: [
      file("app/views/" + .controller + "/index.html.erb", emit([_], {
        match: class: string
        replace: { TITLE:.plural ITEMHELPER:.ui_item_helper }
        body: [
          `<%# Generated by aontu from model.aon. Do not edit. %>`
          `<h1>TITLE</h1>`
          `<table>`
          `  <thead>`
          `    <tr>`

          # THE KEY COLUMN FIRST, THEN THE REST, in two dispatches
          # rather than one over `.field`. The body below writes
          # the key's cell itself, because that cell is a link and
          # the others are not -- so the header has to be built the
          # same way round or the two rows do not line up.
          #
          # It used to line up by luck: `field` was a list, `id`
          # was written first in it, and one loop over the fields
          # put the key column first in both rows. `field` is a map
          # now and a map walks in sorted-key order, which put
          # `diameter` under a header reading `id`. Stating the
          # order the page wants is the fix; the model is not the
          # place for it, because this is a fact about a TABLE.
          emit(filter(.field, { pk:true }), {
            match: name: string
            replace: COLUMN: .name
            body: [`      <th>COLUMN</th>`]
          })
          emit(filter(.field, { pk:false }), {
            match: name: string
            replace: COLUMN: .name
            body: [`      <th>COLUMN</th>`]
          })
          `    </tr>`
          `  </thead>`
          `  <tbody>`
          `    <% @records.each do |record| %>`
          `      <tr>`
          `        <td><%= link_to record.id, ITEMHELPER_path(record.id) %></td>`
          emit(filter(.field, { pk:false }), {
            match: name: string
            replace: COLUMN: .name
            body: [`        <td><%= record.COLUMN %></td>`]
          })
          `      </tr>`
          `    <% end %>`
          `  </tbody>`
          `</table>`
        ]
      }))
      file("app/views/" + .controller + "/show.html.erb", emit([_], {
        match: class: string
        replace: { TITLE:.plural LABEL:.label LISTHELPER:.ui_collection_helper }
        body: [
          `<%# Generated by aontu from model.aon. Do not edit. %>`
          `<h1><%= @record.LABEL %></h1>`
          `<dl>`
          emit(.field, {
            match: name: string
            replace: COLUMN: .name
            body: [`  <dt>COLUMN</dt>` `  <dd><%= @record.COLUMN %></dd>`]
          })
          `</dl>`
          # WHAT HANGS OFF IT gets a list, one per child association.
          # An entity with no children writes none: the conditional
          # IS the selection.
          emit(.children, {
            match: name: string
            replace: HAS: .name
            body: [
              `<h2>HAS</h2>`
              `<ul>`
              `  <% @record.HAS.order(:id).each do |child| %>`
              `    <li><%= link_to child.id, planet_moon_path(@record.id, child.id) %></li>`
              `  <% end %>`
              `</ul>`
            ]
          })
          `<p><%= link_to "All TITLE", LISTHELPER_path %></p>`
        ]
      }))
    ]
  }

  # --- an entity nested under its parent -------------------------------
  {
    match: root: false
    body: [
      file("app/views/" + .controller + "/index.html.erb", emit([_], {
        match: class: string
        replace: { TITLE:.plural ITEMHELPER:.ui_item_helper }
        body: [
          `<%# Generated by aontu from model.aon. Do not edit. %>`
          `<h1>TITLE of <%= @scope.id %></h1>`
          `<table>`
          `  <thead>`
          `    <tr>`

          # The key column first, then the rest, as above.
          emit(filter(.field, { pk:true }), {
            match: name: string
            replace: COLUMN: .name
            body: [`      <th>COLUMN</th>`]
          })
          emit(filter(.field, { pk:false }), {
            match: name: string
            replace: COLUMN: .name
            body: [`      <th>COLUMN</th>`]
          })
          `    </tr>`
          `  </thead>`
          `  <tbody>`
          `    <% @records.each do |record| %>`
          `      <tr>`
          `        <td><%= link_to record.id, ITEMHELPER_path(@scope.id, record.id) %></td>`
          emit(filter(.field, { pk:false }), {
            match: name: string
            replace: COLUMN: .name
            body: [`        <td><%= record.COLUMN %></td>`]
          })
          `      </tr>`
          `    <% end %>`
          `  </tbody>`
          `</table>`
        ]
      }))
      file("app/views/" + .controller + "/show.html.erb", emit([_], {
        match: class: string
        replace: {
          TITLE: .plural
          LABEL: .label
          LISTHELPER: .ui_collection_helper
          OWNERHELPER: .parent_controller
        }
        body: [
          `<%# Generated by aontu from model.aon. Do not edit. %>`
          `<h1><%= @record.LABEL %></h1>`
          `<dl>`
          emit(.field, {
            match: name: string
            replace: COLUMN: .name
            body: [`  <dt>COLUMN</dt>` `  <dd><%= @record.COLUMN %></dd>`]
          })
          `</dl>`
          `<p><%= link_to "All TITLE", LISTHELPER_path(@scope.id) %></p>`
          `<p><%= link_to "Back", OWNERHELPER_path %></p>`
        ]
      }))
    ]
  }
])
