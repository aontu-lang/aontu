%%- # erd.mmd --- the entity-relationship diagram, from the same model.
%%- #
%%- # This file IS a Mermaid diagram: `%%` opens a Mermaid comment, so
%%- # `%%-` marks the aontu and a renderer that does not know about the
%%- # template surface draws the unmarked lines and ignores the rest.
%%- #
%%- # The marker is not in the extension table --- Mermaid is a diagram
%%- # language, not a programming one --- so `render` and `template` are
%%- # both given `--marker '%%-'`. That the table can be overridden is
%%- # the point: a language it has never met needs one flag, not a
%%- # change to the engine.
%%- @"../model.aon"
%%-
%%- out: file("erd.mmd", [
%%-   [
%% Generated by `aontu render` from model.aon. Do not edit.

erDiagram
%%-   ]
%%-
%%-   # ONE LINE PER PARENT-CHILD PAIR, written from the CHILD, which is
%%-   # the end that carries both names: `parent_class` is the owner and
%%-   # `class` is its own. An entity with no parent selects nothing here.
%%-   emit(filter($.entity, { parent:string }), {
%%-     match: parent: string
%%-     replace: { OWNER:upper(.parent_class) OWNED:upper(.class) HAS:.parent_has }
%%-     body: [
  OWNER ||--o{ OWNED : "HAS"
%%-     ]
%%-   })
%%-
%%-   # ONE BLOCK PER ENTITY, its fields in the model's order, with the
%%-   # kind Mermaid shows and the key marker the model's `pk` and `fk`
%%-   # decide. `each` keeps the order a `pack` would sort away.
%%-   emit($.sequence, {
%%-     match: class: string
%%-     replace: ENTITY: upper(.class)
%%-     body: [
  ENTITY {
%%-       emit(each(.field, _ & { mark:"" }), [
%%-         {
%%-           match: pk: true
%%-           replace: { TYPE:.kind COLUMN:.name }
%%-           body: [
    TYPE COLUMN PK
%%-           ]
%%-         }
%%-         {
%%-           match: fk: true
%%-           replace: { TYPE:.kind COLUMN:.name }
%%-           body: [
    TYPE COLUMN FK
%%-           ]
%%-         }
%%-         {
%%-           match: name: string
%%-           replace: { TYPE:.kind COLUMN:.name }
%%-           body: [
    TYPE COLUMN
%%-           ]
%%-         }
%%-       ])
  }
%%-     ]
%%-   })
%%- ])
