+	}
+	if nil != t.authority {
+		b.WriteString("//" + *t.authority)
+	}
+	b.WriteString(t.path)
+	if nil != t.query {
+		b.WriteString("?" + *t.query)
+	}
+	if nil != t.fragment {
+		b.WriteString("#" + *t.fragment)
+	}
