; RFC 4648 section 5, unpadded, with the pad bits of section 3.5 zero.
base64url = [b64u-quantum]
b64u-quantum = b64u-char b64u-second
b64u-second = b64u-low4 [b64u-third] / b64u-high4 b64u-third
b64u-third = b64u-low2 [b64u-fourth] / b64u-high2 b64u-fourth
b64u-fourth = b64u-char [b64u-quantum]
b64u-char = b64u-low2 / b64u-high2
b64u-low4 = %x41 / %x51 / %x67 / %x77
b64u-high4 = %x42-50 / %x52-5A / %x61-66 / %x68-76 / %x78-7A / DIGIT / "-" / "_"
b64u-low2 = %x41 / %x45 / %x49 / %x4D / %x51 / %x55 / %x59 / %x63 / %x67 / %x6B / %x6F / %x73 / %x77 / %x30 / %x34 / %x38
b64u-high2 = %x42-44 / %x46-48 / %x4A-4C / %x4E-50 / %x52-54 / %x56-58 / %x5A / %x61-62 / %x64-66 / %x68-6A / %x6C-6E / %x70-72 / %x74-76 / %x78-7A / %x31-33 / %x35-37 / %x39 / "-" / "_"
