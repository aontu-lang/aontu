; RFC 6570 section 2, a template at level 4: literals and expressions.
; A literal here admits "'", which RFC 6570 excludes: it is an RFC 3986
; sub-delim, and the JSON Schema Test Suite takes it as valid.
uri-template = *(literals / expression)
literals = %x21 / %x23-24 / %x26-3B / %x3D / %x3F-5B / %x5D / %x5F
    / %x61-7A / %x7E / ucschar / iprivate / pct-encoded
expression = "{" [operator] variable-list "}"
operator = "+" / "#" / "." / "/" / ";" / "?" / "&" / "=" / "," / "!" / "@"
    / "|"
variable-list = varspec *("," varspec)
varspec = varname [modifier-level4]
varname = varchar *(["."] varchar)
varchar = ALPHA / DIGIT / "_" / pct-encoded
modifier-level4 = ":" %x31-39 *3DIGIT / "*"
pct-encoded = "%" HEXDIG HEXDIG
ucschar = %xA0-D7FF / %xF900-FDCF / %xFDF0-FFEF / %x10000-1FFFD
    / %x20000-2FFFD / %x30000-3FFFD / %x40000-4FFFD / %x50000-5FFFD
    / %x60000-6FFFD / %x70000-7FFFD / %x80000-8FFFD / %x90000-9FFFD
    / %xA0000-AFFFD / %xB0000-BFFFD / %xC0000-CFFFD / %xD0000-DFFFD
    / %xE1000-EFFFD
iprivate = %xE000-F8FF / %xF0000-FFFFD / %x100000-10FFFD
