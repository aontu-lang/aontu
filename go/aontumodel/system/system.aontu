# aontu:system --- the SYSTEM VOCABULARY. EXPERIMENTAL until the
# distribution layer can version it by canon-hash.

aontu: System: {
  Port: type({ direction: *in|out|inout protocol?:string })

  Component: type({ ports?: { &: $.aontu.System.Port } })

  # Written out rather than Component & { kind: service }: a reference
  # to a type()-marked member does not survive the include.
  Service: type({ kind:service ports?: { &: $.aontu.System.Port } })

  # A grammar, not re(): the identifier shape is a quantified group
  # holding a quantifier, which re() refuses. hide()n so a schema's
  # grammar does not generate into the document it checks.
  semverPreRelease: hide(
    abnf(
      `pre-release = pre-release-id *( "." pre-release-id )
pre-release-id = "0" [ *digit alnum-tail ]
  / positive-digit *digit [ alnum-tail ] / alnum-tail
alnum-tail = non-digit *id-char
id-char = digit / non-digit
non-digit = letter / "-"
digit = "0" / positive-digit
positive-digit = %x31-39
letter = %x41-5A / %x61-7A
`
    )
  )
  semverBuild: hide(
    abnf(
      `build = build-id *( "." build-id )
build-id = 1*id-char
id-char = digit / non-digit
non-digit = letter / "-"
digit = "0" / positive-digit
positive-digit = %x31-39
letter = %x41-5A / %x61-7A
`
    )
  )

  # major minor patch pre-release build, tail defaulted.
  Semver: type(
    [
      integer & min(0)
      *0|(integer & min(0))
      *0|(integer & min(0))
      *""|parse($.aontu.System.semverPreRelease)
      *""|parse($.aontu.System.semverBuild)
    ] & length(5)
  )
}
