# aontu:view --- the FIGURE VOCABULARY. EXPERIMENTAL until the
# distribution layer can version it by canon-hash.

aontu: View: Figure: type({
  kind: doc|lattice|tree|matrix|graph|layer|sets|layers
    | ladder|state|sequence|lane|treemap
  out: string

  # Every kind.
  as?: text|mermaid|dot|er|svg
  at?: string
  maxRows?: integer & min(0)
  of?: string
  ghosts?: boolean

  # tree, matrix, layer, graph, state, lane.
  relation?: string
  relations?: [&: string]
  roots?: [&: string]

  # matrix.
  order?: canon|partition
  closure?: boolean

  # graph, layer, state, lane, treemap.
  groupBy?: string
  label?: string
  layers?: [&: string]
  edges?: upward|all|none
  counts?: boolean
  countBy?: string
  collapse?: boolean
  columns?: string

  splitBy?: string
  splitRoots?: boolean
  budget?: integer & min(0)

  # doc, sequence, treemap.
  depth?: integer & min(0)
  steps?: string
  from?: string
  to?: string
  size?: string

  # sets, layers.
  sets?: string
  member?: string
  universe?: string
  minDegree?: integer & min(0)
  maxCols?: integer & min(0)
  minSize?: integer & min(0)
})
