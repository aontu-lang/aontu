# model.aontu --- the truth. `aontu vet model.aontu data.aontu` asks whether
# a document satisfies it.
#
# `&:` is the construct to learn first: it meets EVERY key of the map
# it sits in, so one statement constrains every entity. A quoted "*" is
# not a wildcard -- it is a key named `*`, it meets nothing, and a
# schema written that way reports `valid` over data that violates it.
# `aontu vet --strict-coverage` refuses to pass such a check.
entity: {
  &: {
    table: string & re("^[a-z][a-z0-9_]*$")
    fields: {
      &: {
        type: "string" | "integer" | "boolean"
        required: *false | boolean
      }
    }
  }
}
