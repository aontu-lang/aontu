import Oracle.Base
import Oracle.Bounds
import Oracle.Choice
import Oracle.PathsSources
import Oracle.Gen
import Oracle.Verdicts
import Oracle.Alias
import Oracle.PathsRefs
import Oracle.PathsLinks
import Oracle.PathsLate
import Oracle.PathsAnnotation
import Oracle.Trials
import Oracle.Subsume
import Oracle.Fragment
import Oracle.SubsumeDocs
import Oracle.Forms
import Oracle.Calls
import Oracle.CallsTemplates
import Oracle.Custom
import Oracle.EmitData
import Oracle.LinkClimb

/-!
# The oracle

Enumerates every value of the fragment up to one meet against a set of
data, and prints each case with the definition's verdict. The
verdict comes from `check`, which `check_iff` makes the definition's on
every value that reads no reference: `vals_checkable` proves every value
here is one, `instances_wellFormed` proves every instance a value, and
`verdict_exact` puts the three together.
-/

open Aontu
open Case

set_option maxRecDepth 2048 in
def main (args : List String) : IO UInt32 := do
  match args with
  | [] =>
    IO.println "# Generated by `lake exe oracle` (spec/Oracle.lean) from the definition in"
    IO.println "# spec/Aontu: every value of the fragment up to one meet (600) against 24"
    IO.println "# instances, the first 16 in rows c0 to c9599 and the other 8 after them,"
    IO.println "# as `verdict` rows whose expectation is the verdict `check` gives, which"
    IO.println "# `check_iff` makes the definition's own: a value it admits is `valid`, or an"
    IO.println "# `error` where `vet` reads the value as ill-formed (`rowDoc_error_exact`) and"
    IO.println "# it writes no `nil`, and a refusal is written as the three classes it may be."
    IO.println "# Each row runs plain `vet`, its data written in aontu, exact numbers marked `0d`."
    IO.println "# Regenerate with `make spec`; never edit by hand. The cases the ports do"
    IO.println "# not yet answer this way are listed in spec/ledger.tsv."
    IO.println "# The words `map` and `list` follow in rows k0 on: each alone, under a key,"
    IO.println "# and in a few meets (13 values), against all 24 instances."
    rows "c" vals [first, more]
    rows "k" kindVals [instances]
    return 0
  | ["bounds"] =>
    IO.println "# Generated by `lake exe oracle bounds` (spec/Oracle.lean) from the definition"
    IO.println "# in spec/Aontu: the bounds beyond min, max, and mulof (above, below, the"
    IO.println "# string bounds, neq, len, unique), each alone and under a key, and the meets"
    IO.println "# of eight of them pairwise (115 values), against 30 instances, as `verdict`"
    IO.println "# rows whose expectation is the verdict `check` gives, which `check_iff`"
    IO.println "# makes the definition's own; a refusal is written as the three classes it"
    IO.println "# may be. Each row runs plain `vet`, its data written in aontu."
    IO.println "# Regenerate with `make spec`; never edit by hand. The cases the ports do"
    IO.println "# not yet answer this way are listed in spec/ledger.tsv."
    rows "b" boundVals [boundInstances]
    return 0
  | ["choice"] =>
    IO.println "# Generated by `lake exe oracle choice` (spec/Oracle.lean) from the definition"
    IO.println "# in spec/Aontu: disjunction and preference over scalars, kinds, bounds, and"
    IO.println "# sealed lists, with a few meets, each alone and under an optional key (50"
    IO.println "# values), against 22 instances, as `verdict` rows whose expectation is the"
    IO.println "# verdict `check` gives, which `check_iff` makes the definition's own; a"
    IO.println "# refusal is written as the three classes it may be. No map stands in an arm"
    IO.println "# and no preference under a required key, where the verdict is the"
    IO.println "# evaluator's question. Each row runs plain `vet`, its data written in aontu."
    IO.println "# Regenerate with `make spec`; never edit by hand. The cases the ports do"
    IO.println "# not yet answer this way are listed in spec/ledger.tsv."
    rows "d" choiceVals [choiceInstances]
    return 0
  | ["gen"] =>
    IO.println "# Generated by `lake exe oracle gen` (spec/Oracle.lean) from the definition in"
    IO.println "# spec/Aontu: what evaluation singles out, `Output`, on literals, preferences"
    IO.println "# and disjunctions with their ranks, maps and lists with defaults and spreads,"
    IO.println "# and meets of these, as `gens` rows whose expectation is the JSON of the"
    IO.println "# value `output` gives, which `output_iff` makes the definition's own. A value"
    IO.println "# that singles out nothing has no row until P5 names its class. Each row runs"
    IO.println "# evaluation on a document with the one key `v`."
    IO.println "# Regenerate with `make spec`; never edit by hand. The cases the ports do"
    IO.println "# not yet answer this way are listed in spec/ledger.tsv."
    IO.println "# Variables, each the value both runners bind for every row, follow in rows"
    IO.println "# i0 on, read as names the calling program declares."
    IO.println "# Path values follow in rows k0 on: path(p) generates its own address, two"
    IO.println "# meet by the prefix rule, the longer winning, and path admits each. A string"
    IO.println "# constraint reads an address by its spelling, in rows ks0 on."
    IO.println "# Lists that hold a marked element follow in rows gl0 on, read as a document"
    IO.println "# reads them: the list holds no position for the element."
    IO.println "# Numbers at so many significant digits follow in rows gs0 on:"
    IO.println "# `Number.significant` (spec/Aontu/Written.lean), written as the gen() call"
    IO.println "# both engines read."
    IO.println "# Numbers at so many places, at both counts, and as strings follow in rows gw0"
    IO.println "# on: `Number.rounded` and `Number.written`, in the same module."
    IO.println "# What a document writes under its output annotations follows in rows wa0 on:"
    IO.println "# `outputW` (spec/Aontu/Writing.lean), each value written by the record it"
    IO.println "# carries, a number rounded or as text, a boolean as a number or its name, a"
    IO.println "# string in a case, an address in a form, a map's keys in a style, and a value"
    IO.println "# written empty left out under empty: \"omit\"."
    genRows "g" genVals
    varRows "i"
    genRows "k" addrVals
    genRows "ks" spellVals
    readGenRows "gl" listGenVals
    significantRows "gs" significantCases
    writtenRows "gw" writtenCases
    writeRows "wa" writeCases
    return 0
  | ["verdict"] =>
    IO.println "# Generated by `lake exe oracle verdict` (spec/Oracle.lean) from the definition"
    IO.println "# in spec/Aontu: the verdicts of vet, each case a schema and a document under"
    IO.println "# the key v, run in the default mode, without the fill (noFill) and under"
    IO.println "# --partial (partial), as `verdict` rows whose expectation is the one class"
    IO.println "# `vet` gives, which `vet_iff` makes the definition's own: error where the"
    IO.println "# schema does not stand, invalid where the meet is dead, valid where it"
    IO.println "# singles out a value (and the data is an instance, without the fill), and"
    IO.println "# incomplete otherwise."
    IO.println "# Regenerate with `make spec`; never edit by hand. The cases the ports do"
    IO.println "# not yet answer this way are listed in spec/ledger.tsv."
    IO.println "# A size met with a container literal follows in rows l0 on: an error where"
    IO.println "# the size's upper half refuses the literal's count, the lower end waiting"
    IO.println "# for generation, and an optional member whose value generates an empty map"
    IO.println "# or list not counted."
    IO.println "# The marks follow in rows h0 on: hide() and type() leave a member of a map"
    IO.println "# out of the output, the member still meeting the data, and --no-fill reads"
    IO.println "# the schema's visible part. A list holds no position for an element a mark"
    IO.println "# of its own leaves out, in rows hl0 on."
    IO.println "# Path values follow in rows k0 on: the fill supplies a path value the data"
    IO.println "# leaves out, and none admits the string the data writes for it, since no"
    IO.println "# JSON text reads as an address. A string constraint the address passes by"
    IO.println "# its spelling leaves the fill as it is, in rows ks0 on."
    IO.println "# Without the fill, a disjunction admits what any arm admits, whatever its"
    IO.println "# rank, so an arm beside the default that admits the data as written is"
    IO.println "# enough, in rows na0 on. A preference as an arm is its value alone, with no"
    IO.println "# parent type, which a lone preference keeps, in rows pa0 on. Defaults of one"
    IO.println "# rank fold into their meet, and of two ranks the lower one's wins while the"
    IO.println "# higher one's still constrains (ruling 41) and its default fills in under"
    IO.println "# the lower one's (ruling 42). An arm that was not a default stays one,"
    IO.println "# whichever side of the meet holds it (decision 43), in rows rk0 on."
    IO.println "# Each read mode's reading of a number the data writes follows in rows n0 on"
    IO.println "# (decisions 70 and 71), against each number kind: under --exact-numbers"
    IO.println "# (exactNumbers) its exact value, within the exactness budget, and otherwise"
    IO.println "# the double nearest it, a whole number no double holds and one beyond the"
    IO.println "# double's range refused, so the data is invalid."
    verdictRows "e"
    verdictRows "l" lenCases
    verdictRows "h" markCases
    verdictRows "hl" markListCases
    verdictRows "k" addrVetCases
    verdictRows "ks" spellVetCases
    verdictRows "na" armCases
    verdictRows "pa" prefArmCases
    verdictRows "rk" rankFoldCases
    readRows "n"
    return 0
  | ["alias"] =>
    IO.println "# Generated by `lake exe oracle alias` (spec/Oracle.lean) from the definition"
    IO.println "# in spec/Aontu: documents with alias declarations, each case its declarations"
    IO.println "# and a schema under the key v against a document under the key v, run in the"
    IO.println "# default mode, without the fill (noFill) and under --partial (partial), as"
    IO.println "# `verdict` rows whose expectation is the one class `vet` gives, which `vet_iff`"
    IO.println "# makes the definition's own. A document reads as its expansion; a name declared"
    IO.println "# nowhere, or names that break the alias-cycle rule, are an error. A recursive"
    IO.println "# name is a residual that expands against the data, as far as it goes."
    IO.println "# Regenerate with `make spec`; never edit by hand. The cases the ports do"
    IO.println "# not yet answer this way are listed in spec/ledger.tsv."
    IO.println "# The riders follow in rows r0 on: meta() and deprecate() judging as their"
    IO.println "# values, ident() on an alias's value, and ident() anywhere else, an error,"
    IO.println "# in a body no reference reads as in one a reference does."
    IO.println "# The marks under the names follow in rows n0 on: a reference copies a body"
    IO.println "# with its marks cleared at every depth, and a mark written at the reference"
    IO.println "# stays."
    IO.println "# The seal a reference puts on a type() value follows in rows o0 on: the copy"
    IO.println "# admits nothing the definition does not declare, at any depth, and a"
    IO.println "# recursive name takes none."
    IO.println "# open() follows in rows op0 on: every seal in its value lifted, at every"
    IO.println "# depth, a spread's template kept as written, a member written open() under"
    IO.println "# a sealed map held open, open() beside a sealed term lifting nothing there,"
    IO.println "# and the seal on a type() value's copy lifted by open() around the"
    IO.println "# reference and stopped by open() inside it."
    IO.println "# A bare open() and a bare close() follow in rows dir0 on, directives on"
    IO.println "# their place: close() seals the place once its terms have met, and every"
    IO.println "# level beneath it but those held open; open() lifts every seal at its"
    IO.println "# place, at every depth; close() wins at its own level; the places beneath"
    IO.println "# are read first; a disjunction's arm and a spread's template are places of"
    IO.println "# their own, and a directive beside one disjunction or lone preference"
    IO.println "# reaches each of its arms, read with the terms beside it."
    IO.println "# The shorthand { %a %b } follows in rows sh0 on (P10): a set of names stands"
    IO.println "# for the map that binds each one under its own key, its names apart by"
    IO.println "# spaces or by commas, alone or under a key."
    IO.println "# A destructure over a term that isn't a load follows in rows ds0 on (P10):"
    IO.println "# a map, a number, a name, a name taken under another and two names, each an"
    IO.println "# error, since no source stands under it."
    aliasRows "a"
    aliasRows "r" riderCases
    aliasRows "n" markAliasCases
    aliasRows "o" sealCases
    aliasRows "op" openCases
    aliasRows "dir" directiveCases
    shortRows "sh"
    aliasRows "ds" destrCases
    return 0
  | ["paths"] =>
    IO.println "# Generated by `lake exe oracle paths` (spec/Oracle.lean) from the definition"
    IO.println "# in spec/Aontu: documents with paths, each case its declarations and a map"
    IO.println "# as the schema against a map as the document, run in the default mode,"
    IO.println "# without the fill (noFill) and under --partial (partial), as `verdict` rows"
    IO.println "# whose expectation is the one class `vet` gives the document with its paths"
    IO.println "# read as names, which `vetP_iff` makes the definition's own. A path resolves"
    IO.println "# in the schema's own tree, through maps and lists and through nothing else,"
    IO.println "# and reads as the term at its position in the schema met with the data; a"
    IO.println "# path to nothing is an error, as is a document that reads only by its own"
    IO.println "# paths. Regenerate with `make spec`; never edit by hand. The cases the ports"
    IO.println "# do not yet answer this way are listed in spec/ledger.tsv."
    IO.println "# Paths through the riders follow in rows q0 on, which a path reads through,"
    IO.println "# and key(n) reached through a path or a name, read where it lands, in rows r0 on."
    IO.println "# Relative paths, made absolute where each stands, follow in rows j0 on, with"
    IO.println "# the bodies read at an alias's own place written again after the schema in"
    IO.println "# rows jl0 on, and"
    IO.println "# maybe, absence where all that is wrong with a path is that it names nothing,"
    IO.println "# in rows mb0 on, a list holding no position for absence in rows la0 on,"
    IO.println "# and pref, each literal a preference and each preference a"
    IO.println "# rank weaker, in rows pf0 on. Paths into a call's output, which resolve in the"
    IO.println "# root with its calls made, follow in rows pc0 on, and move, a preference of"
    IO.println "# the value a path reads with its source hidden, in rows mv0 on. Paths into"
    IO.println "# what a call over a path makes, which resolve a round later, follow in rows"
    IO.println "# rn0 on, and relate, a link that keeps its address, its template met into"
    IO.println "# its target, in rows rf0 on. A relation whose value holds a link at"
    IO.println "# each leaf follows in rows rl0 on, a constraint met with relate() before its"
    IO.println "# value, which meets the value as any meet does, in rows rh0 on, and links"
    IO.println "# read where they land, in a spread's template or copied by a path"
    IO.println "# reference, a relative address read where the copy stands, in rows ld0"
    IO.println "# on, and in a generator's template, at each member"
    IO.println "# of its output, in rows lg0 on. Spreads whose templates read their member's"
    IO.println "# place, each read at each member there is, follow in rows sp0 on, and"
    IO.println "# sources loaded in place, each a file of test/spec/files the definition"
    IO.println "# declares as a term, in rows lf0 on."
    IO.println "# Generators whose templates read their member's place through a relative"
    IO.println "# path, each read at each member of the output, follow in rows gt0 on, a spread"
    IO.println "# such a template holds, read at each member, a member the data adds among them,"
    IO.println "# in rows sg0 on, a written nil, which forbids an optional member and leaves a"
    IO.println "# required one unmet and an arm that holds one refusing (ruling 54), in rows"
    IO.println "# nl0 on, and"
    IO.println "# templates that meet their own hole, each member kept and met with the rest,"
    IO.println "# the `_ & …` idiom, in rows ib0 on, generators an emit's body holds, their"
    IO.println "# templates read where each instance lands in the output, in rows eg0 on,"
    IO.println "# with a filter there in rows eh0 on, the same through a named table in rows"
    IO.println "# ng0 on, and beside a key(n) in rows kr0 on, a"
    IO.println "# filter's condition, read where the member it tries lands, in rows fc0 on,"
    IO.println "# bounds written over terms, each the bound its terms name, in rows bd0 on, and"
    IO.println "# bounds over a relative path in a generator's template or a filter's"
    IO.println "# condition, each read where its instance lands, in rows bg0 on. Sources that"
    IO.println "# declare names of their own, each read in its own scope, follow in rows ls0 on,"
    IO.println "# and the names a source publishes, with the destructures that take them, in"
    IO.println "# rows lx0 on, and in a declaration's body in rows lb0 on. Module imports, each"
    IO.println "# the source the calling program supplies for the import as written, follow in"
    IO.println "# rows lm0 on, over the projects of test/spec/files. The transformer emit"
    IO.println "# over a selection a path names follows in"
    IO.println "# rows em0 on, and copy, its argument with the marks and the seal cleared at"
    IO.println "# every depth, in rows cp0 on. Links whose templates read the member or the"
    IO.println "# place where they land, each read there and only at the instances its own"
    IO.println "# generator makes, follow in rows lt0 on. A call over a hole that a path names,"
    IO.println "# which nothing binds, so the schema is an error whatever the data, in rows dp0 on."
    IO.println "# A meet carries the marks of both its sides, any's included, in rows hm0 on."
    IO.println "# A spread's template meets each member without the marks written around it"
    IO.println "# (ruling 39), in rows sm0 on. A relative path in apply's template reads where"
    IO.println "# the call stands, in rows ar0 on. A copy reads the relative paths it copies"
    IO.println "# where it stands (ruling 26): a use of a name in rows cd0 on, written again"
    IO.println "# after the schema in rows cdl0 on, a path reference in rows rc0 on, and a name"
    IO.println "# whose body holds one, or a use inside a body read at the body's own place,"
    IO.println "# in rows bc0 on, written again after the schema in rows bcl0 on. A name whose"
    IO.println "# body holds a spread whose template reads its member's place reads it at each"
    IO.println "# member where it's used and at its own place, in rows nt0 on and ntl0 on."
    IO.println "# A template in a selection's result reads its member's place where the"
    IO.println "# selection stands, in rows st0 on and stl0 on."
    IO.println "# A path written in a disjunction's arm reads where the arm holds, in rows dj0"
    IO.println "# on and djl0 on. A path inside a lone preference reads where the preference"
    IO.println "# holds its value, and its parent arm lifts what the value reads as on its own"
    IO.println "# (ruling 40), in rows lp0 on and lpl0 on. Lone preferences met at one place"
    IO.println "# read as one disjunction, each arm met with each arm (ruling 53), in rows lq0 on."
    pathRows "p"
    pathRows "q" riderPathCases
    pathRows "r" keyPathCases
    pathRows "j" relPathCases
    pathRows "jl" aliasPlaceCases (declsLast := true)
    pathRows "cd" copyDestCases
    pathRows "cdl" copyDestCases (declsLast := true)
    pathRows "rc" refCopyCases
    pathRows "bc" bodyCopyCases
    pathRows "bcl" bodyCopyCases (declsLast := true)
    pathRows "nt" nameTemplateCases
    pathRows "ntl" nameTemplateCases (declsLast := true)
    pathRows "st" selectTemplateCases
    pathRows "stl" selectTemplateCases (declsLast := true)
    pathRows "dj" disjunctionPathCases
    pathRows "djl" disjunctionPathCases (declsLast := true)
    pathRows "lp" lonePrefPathCases
    pathRows "lpl" lonePrefPathCases (declsLast := true)
    pathRows "lq" lonePrefCases
    pathRows "mb" maybeCases
    pathRows "la" absentListCases
    IO.println "# A sum of an absence is absent, and the key that holds it is left out, in"
    IO.println "# rows su0 on: absence on either side of `+`, beside a list, a string and a"
    IO.println "# number, in a list, inside another sum, met with a kind and under an"
    IO.println "# optional key."
    pathRows "su" sumAbsentCases
    IO.println "# A spread's template doesn't apply to a member that is absence, in rows ab0"
    IO.println "# on: the map leaves the member out as it would with no template, the"
    IO.println "# template still holds what the data gives at the key, and the absence may"
    IO.println "# be computed, by a sum, a call, a meet of two or under a mark."
    pathRows "ab" absentSpreadCases
    pathRows "pf" prefCases
    pathRows "pc" callPathCases
    pathRows "dp" dataPathCases
    pathRows "mv" (moveCases ++ moveReadCases ++ moveListCases)
    pathRows "rn" roundCases
    pathRows "rf" referCases
    pathRows "rl" relCases
    IO.println "# A string is never a path: the path kind met with a string, and a relation"
    IO.println "# over a list of strings, are each the schema's error, in rows sn0 on."
    pathRows "sn" addressStringCases
    pathRows "rh" relHeldCases
    pathRows "ld" landCases
    pathRows "lg" genLinkCases
    pathRows "sp" spreadCases
    pathRows "lf" loadCases
    pathRows "gt" genTemplateCases
    pathRows "sg" spreadGenCases
    pathRows "nl" writtenNilCases
    pathRows "ib" holeMeetCases
    pathRows "eg" emitGenCases
    pathRows "eh" emitGenFilterCases
    pathRows "ng" namedGenCases
    pathRows "kr" keyRelCases
    pathRows "fc" filterCondCases
    pathRows "fk" filterKeepCases
    pathRows "rs" recursiveSelectCases
    pathRows "ft" filterTermCases
    pathRows "hm" markMeetCases
    pathRows "sm" spreadMarkCases
    pathRows "bd" boundArgCases
    pathRows "bg" (boundFilterCases ++ boundEachCases)
    pathRows "ls" scopeCases
    pathRows "lx" takeCases
    pathRows "lb" bodyTakeCases
    pathRows "lm" moduleCases
    pathRows "em" (emitPathCases ++ emitFilterCases)
    pathRows "cp" copyCases
    pathRows "lt" linkTemplateCases
    pathRows "ar" applyPathCases
    IO.println "# A bare close() and a bare open() beside path references follow in rows"
    IO.println "# dirp0 on: a sealed place's copy sealed, close() beside a reference sealing"
    IO.println "# the terms read there, open() beside one lifting the target's seal, and"
    IO.println "# close() at the document's root."
    pathRows "dirp" directivePathCases
    IO.println "# A bare directive beside a path at more places follows in rows db0 on: the"
    IO.println "# copy sealed with the keys its target holds, beside a map and a second path,"
    IO.println "# in a template, under a default and in an arm, and a path inside the terms"
    IO.println "# a directive seals, at the root, in a template and in copy's argument."
    pathRows "db" directiveBesideCases
    IO.println "# A link's template read where it lands, at the link's target (ruling 50),"
    IO.println "# follows in rows ll0 on."
    pathRows "ll" linkLandCases
    IO.println "# More of a link's template read where it lands follows in rows lr0 on: a"
    IO.println "# target that isn't the link's sibling, a path deeper in the template, a call"
    IO.println "# over such a path, a member the target doesn't declare, and two links into"
    IO.println "# one target."
    pathRows "lr" linkReadCases
    IO.println "# A path in a link's template that climbs past the template reads where the"
    IO.println "# link is written (ruling 92), in rows lc0 on: past the template by one step"
    IO.println "# and by two, from deeper in it, beside a path that stays inside, under a"
    IO.println "# call, past the top and in a declaration's body."
    pathRows "lc" linkClimbCases
    IO.println "# A recursive name whose body links back to it follows in rows rx0 on: a use"
    IO.println "# of it alone stays residual, and one met with a map unfolds."
    pathRows "rx" recursiveLinkCases
    IO.println "# A recursive name met with a kind, a disjunction and another recursive name"
    IO.println "# follows in rows rm0 on: a kind picks among the name's branches as structure"
    IO.println "# does, a disjunction meets it arm by arm, and two names met hold both."
    pathRows "rm" residualMeetCases
    IO.println "# A use of a recursive name whose body reads its own place reads as a copy"
    IO.println "# of the body placed where it stands, at each level the data or the schema"
    IO.println "# reaches (ruling 26), in rows rr0 on."
    pathRows "rr" recursiveCopyCases
    IO.println "# A match whose scrutinee the schema leaves open waits for the data (ruling 49),"
    IO.println "# in rows os0 on."
    pathRows "os" openSelectCases
    IO.println "# A match whose scrutinee generates no value takes the arm no data could change"
    IO.println "# (ruling 87), in rows ca0 on: an arm the scrutinee sits below is taken, one"
    IO.println "# that shares nothing with it is passed over, and any other waits for the data."
    pathRows "ca" certainSelectCases
    IO.println "# A spread's template that holds two defaults of the picked rank that disagree is"
    IO.println "# the schema's error where it is written, whatever the data (ruling 90), in rows"
    IO.println "# tc0 on."
    pathRows "tc" templateClashCases
    IO.println "# A default that reaches a disjunction as an arm, by a call, a name, a path or a"
    IO.println "# meet, stands as the arm it is, of its rank with no parent type (ruling 89), in"
    IO.println "# rows da0 on, and a match's result that is one in rows as0 on."
    pathRows "da" armStandsCases
    pathRows "as" armStandsSelectCases
    IO.println "# A match, a nof, a must or a when that tries a call that waits waits with it,"
    IO.println "# whichever way the value would go (#432), in rows wt0 on; a call in a spread's"
    IO.println "# template, and one in a result the value doesn't take, makes nothing wait."
    pathRows "wt" waitCases
    IO.println "# A path in a lone preference's value that names nothing there is the schema's"
    IO.println "# error whatever the data, as it is outside a preference (ruling 53), in rows"
    IO.println "# sy0 on; a path the term beside the preference answers stands, and one in a"
    IO.println "# preferred arm fails that arm alone. The same preference follows as an optional"
    IO.println "# member, under a rider, in a call, as a declaration's body and as a spread's"
    IO.println "# template, which is no error until a member reads it."
    pathRows "sy" strayPathCases
