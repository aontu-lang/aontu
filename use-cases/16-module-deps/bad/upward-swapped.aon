# bad/upward-swapped.aon --- bad/upward.aon with its two blocks in the
# OPPOSITE order. Same edges, same layers, same mirrors.
#
# IT REFUSES, the same way its twin does. It did not always: which
# target shape reached the far end of an edge used to depend on the
# order the blocks were written in, because a flow nested inside
# another flow had its record dropped rather than deferred, so the
# narrow CoreDep shape never reached this edge when catalog was
# written first (BUGS.md 69). This file stood here as a KNOWN MISS
# until that was fixed, and stays as the pin that the rule holds in
# every spelling.
@"../model.aon"

mods: {
  catalog: {
    usedBy: [path($.mods.server), path($.mods.auth)]
  }
  auth: {
    dependsOn: [
      path($.mods.bytes), path($.mods.http), path($.mods.catalog)
    ]
  }
}
