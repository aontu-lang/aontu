# model.aon --- twelve services on one message wire, and what each
# deployed handler must do: the patterns it listens on, the patterns it
# calls out to, and the S3 events it picks up. The model is the only
# input; the handlers are generated from it (gen.aon) and never edited.
#
# Every service has the three keys, empty where it has nothing to say,
# because the generator reads them all: a dispatch over an empty
# selection emits nothing, which is the whole conditional mechanism.
services: {
  ingest: listen: [pin:"sys:ingest,cmd:run"]
  ingest: client: [pin:"sys:store"]
  ingest: on: file: events: [{ source:s3 msg:"sys:ingest,cmd:file" }]
  parse: listen: [pin:"sys:parse,cmd:run"]
  parse: client: [pin:"sys:store" pin:"sys:embed"]
  parse: on: file: events: []
  embed: listen: [pin:"sys:embed,cmd:run"]
  embed: client: [pin:"sys:store"]
  embed: on: file: events: []
  search: listen: [pin:"sys:search,cmd:query"]
  search: client: [pin:"sys:embed" pin:"sys:store"]
  search: on: file: events: []
  chat: listen: [pin:"sys:chat,cmd:ask" pin:"sys:chat,user:o'brien"]
  chat: client: [pin:"sys:search"]
  chat: on: file: events: []
  summary: listen: [pin:"sys:summary,cmd:run"]
  summary: client: [pin:"sys:store"]
  summary: on: file: events: [{ source:s3 msg:"sys:summary,cmd:file" }]
  index-build: {
    listen: [pin:"sys:index,cmd:build"]
    client: [pin:"sys:store" pin:"sys:embed"]
    on: file: events: [
      { source:s3 msg:"sys:index,cmd:file" }
      { source:sqs msg:"sys:index,cmd:queue" }
    ]
  }
  notify: { listen:[pin:"sys:notify,cmd:send"] client:[] on:file:events:[] }
  billing: listen: [pin:"sys:billing,cmd:charge" pin:"sys:billing,cmd:refund"]
  billing: client: [pin:"sys:notify"]
  billing: on: file: events: []
  audit: listen: [pin:"sys:audit,cmd:record"]
  audit: client: []
  audit: on: file: events: [{ source:s3 msg:"sys:audit,cmd:file" }]
  export: listen: [pin:"sys:export,cmd:run"]
  export: client: [pin:"sys:store"]
  export: on: file: events: []
  admin: listen: [pin:"sys:admin,cmd:list"]
  admin: client: [pin:"sys:store" pin:"sys:billing" pin:"sys:notify"]
  admin: on: file: events: []
}
