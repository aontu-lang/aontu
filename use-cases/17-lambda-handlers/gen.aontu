# gen.aontu --- the handler generator, in the canonical form: one rule
# set whose body is the handler file, line for line, with three nested
# dispatches where the file varies per service. This is the generator
# the template surface desugars to (docs/design/TEMPLATE.0.md D7), and
# it is the acceptance of RENDER P6: `replace` carries a value into a
# line with no hole syntax, `esc: sq` escapes it for the single-quoted
# literal it lands in, and two lines that are two spaces and nothing
# else survive because a line is verbatim.
@"./model.aontu"

# Each service carries its own name, so a rule can read it.
svc: $.services & pack($.services, { name:key() })

%handler = emit(_, {
  match: name: string
  esc: sq
  replace: SERVICE: .name
  body: [
    "import { getSeneca } from '../../env/lambda/lambda'"
    ""
    "function complete(seneca: any) {"
    emit(.listen, {
      match: pin: string
      esc: sq
      replace: PIN: .pin
      body: ["  seneca.listen({type:'sqs',pin:'PIN'})"]
    })
    emit(.client, {
      match: pin: string
      esc: sq
      replace: PIN: .pin
      body: ["  seneca.client({type:'sqs',pin:'PIN'})"]
    })
    emit(filter(.on.file.events, { source:s3 }), {
      match: { source:s3 msg:string }
      esc: sq
      replace: MSG: .msg
      body: [
        ""
        "  const makeGatewayHandler = seneca.export('s3-store/makeGatewayHandler')"
        "  seneca"
        "    .act('sys:gateway,kind:lambda,add:hook,hook:handler', {"
        "       handler: makeGatewayHandler('MSG') })"
      ]
    })
    "}"
    ""
    "exports.handler = async ("
    "  event:any,"
    "  context:any"
    ") => {"
    "  "
    "  let seneca = await getSeneca('SERVICE', complete)"
    "  "
    "  let handler = seneca.export('gateway-lambda/handler')"
    "  let res = await handler(event, context)"
    "  return res"
    "}"
  ]
})

# One unit per service, and an index that names them all in the
# model's order: `each` keeps that order where a pack would sort, and
# the name-derivation chain -- split, form, join -- spells the constant.
# The unit list is one dispatch over two parts, the service map and the
# index marker, tried in sorted-key order.
parts: { handlers:$.svc index:true }

out: emit($.parts, [
  {
    match: map()
    body: [
      emit(_, {
        match: name: string
        body: [
          file("handlers/" + .name + ".ts", emit([_], %handler))
        ]
      })
    ]
  }
  {
    match: true
    body: [
      file("index.ts", [
        each(pick($.svc, name), line(
          "export const "
          + join(each(split(_, "-"), upper(_)), "_")
          + " = '" + _ + "'"))
      ])
    ]
  }
])
