# gen-go.aon --- Go structs from model.aon, as a component tree.
#
# THE SHAPE, and why. A rule set (`emit`) walks the records, and each
# node it visits contributes CHILDREN of the file: a record is a blank
# line, a head, its fields and a tail; a field is one line. A `Line`
# writes its own terminator, so nothing here spells a newline, and the
# indent is the target's own tab, written into the string: aontu knows
# no languages and has no view about how Go indents.
#
#   emit($.records, %go_record)   a dispatch in SOURCE order, which is
#                              what a file needs; `pack` would key by
#                              data and emit the records alphabetically.
#
#   emit(.fields, %go_field)      a nested dispatch, spliced into the
#                              record's children: the body is flat, so
#                              the file's lines are flat.
#
# The Go emitter reads the `go` slice of the model and never `sql`;
# the names are model data (see model.aon), not emitter logic.
@"./model.aon"

%go_field = emit(_, {
  match: n: string
  body: [
    line(
      "\t" + .go + " " + match(.t, "string", "string", "integer", "int64")
      + ` \`json:"` + .n + `"\``
    )
  ]
})

%go_record = emit(_, {
  match: name: string
  body: [
    line("")
    line("type " + .name + " struct {")
    emit(.fields, %go_field)
    line("}")
  ]
})

go: file("types.go", [
  line("// Code generated by aontu from model.aon. DO NOT EDIT.")
  line("")
  line("package acme")
  emit($.records, %go_record)
])
