# gen-sql.aon --- CREATE TABLE statements from model.aon, as an
# aontu:code instance.
#
# Reads the `sql` slice and ignores `go` entirely. Identifiers are
# QUOTED, because `order` is a reserved word in SQL and a generator
# that emits it bare produces a file that does not parse -- the
# reserved-word problem every code generator meets, answered here by
# always quoting rather than by carrying a word list.
#
# THE COLUMN LIST IS A FOLD. A separator that goes BETWEEN N items and
# not after the last is `join`, so the columns are emitted as strings
# and joined with `,\n` into one block that a RAW piece carries at
# depth 1: the renderer re-indents its lines and adds no comma of its
# own. A raw piece is verbatim, which the render report says (tier 3)
# and `--strict` would refuse; this block is SQL the generator wrote,
# so the check does not run under `--strict`.
#
# THE COLUMN TABLE IS WRITTEN INLINE, not named: a named table
# (`%column = emit(_, ...)`) resolves as a body element but not as the
# argument of a call inside a body, and `join(emit(.fields, %column))`
# is that position (use-cases/BUGS.md 84). Both ports agree, so the
# inline spelling is the portable one.
@"./model.aon"

%sql_table = emit(_, {
  match: sql: string
  body: [
    line("")
    line(`CREATE TABLE "` + .sql + `" (`)
    # THE COMMA SEPARATES, so the field list is ONE line whose text
    # carries its own newlines: a `line` per field would need to know
    # which one is last.
    line(join(
      emit(.fields, {
        match: sql: string
        body: [
          `  "` + .sql + `" `
          + match(.t, "string", "TEXT", "integer", "BIGINT")
          + match(.req, true, " NOT NULL", false, "")
        ]
      }),
      ",\n"
    ))
    line(");")
  ]
})

sql: file("schema.sql", [
  line("-- Code generated by aontu from model.aon. DO NOT EDIT.")
  emit($.records, %sql_table)
])
