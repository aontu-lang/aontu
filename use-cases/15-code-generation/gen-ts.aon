# gen-ts.aon --- TypeScript interfaces from model.aon.
#
# This generator reads NEITHER the `go` nor the `sql` slice: a
# TypeScript property keeps the wire name. Optionality becomes `?`,
# which is `match` on a boolean rather than anything clever.
#
# `rows` IS NOT HIDDEN, AND THAT IS DELIBERATE. The obvious spelling
# wraps the staged intermediate in `hide()` so the scaffolding stays
# out of the generated value. It does not survive the parity probe:
# inside `hide()` the Go port never resolves the spread template's
# `.n`, so the transform generates in TypeScript and refuses in Go
# with `mapval_no_gen` -- opposite exit codes on the same document
# (use-cases/BUGS.md 63). Left unhidden, both ports agree byte for
# byte, which check.sh asserts. `rows` therefore rides in the
# evaluated value and the fold ignores it.
@"./model.aon"

units: [&: {
  head: `export interface ` + .name + ` {`
  rows: [&: {
    out: `  ` + .n + match(.req, true, ``, false, `?`) + `: ` +
         match(.t, "string", `string`, "integer", `number`)
  }] & .fields
  body: pick(.rows, out)
  tail: `}`
}] & $.records
