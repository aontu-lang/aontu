# gen-ts.aon --- TypeScript interfaces from model.aon, as a component
# tree.
#
# This generator reads NEITHER the `go` nor the `sql` slice: a
# TypeScript property keeps the wire name. Optionality becomes `?`,
# which is `match` on a boolean rather than anything clever. The shape
# is gen-go.aon's -- a rule set over the records, a nested one over
# each record's fields -- and the two-space indent is written into the
# string, as Go's tab is there.
@"./model.aon"

%ts_field = emit(_, {
  match: n: string
  body: [
    line(
      "  " + .n + match(.req, true, "", false, "?") + ": "
      + match(.t, "string", "string", "integer", "number")
    )
  ]
})

%ts_record = emit(_, {
  match: name: string
  body: [
    line("")
    line("export interface " + .name + " {")
    emit(.fields, %ts_field)
    line("}")
  ]
})

ts: file("types.ts", [
  line("// Code generated by aontu from model.aon. DO NOT EDIT.")
  emit($.records, %ts_record)
])
