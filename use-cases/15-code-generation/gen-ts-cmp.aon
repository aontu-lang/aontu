# gen-ts-cmp.aon --- gen-ts.aon's output, written as a COMPONENT TREE
# rather than as an aontu:code instance.
#
# The tree IS the deliverable: it is the shape a component engine
# consumes, so this document ends at `aontu gen-ts-cmp.aon` and the
# hand-off is a pipe. check.sh holds the bytes it carries to the same
# golden the aontu:code spelling renders, and holds both ports to the
# same tree. The two files together are what each spelling costs.
@"./model.aon"

%ts_field = emit(_, {
  match: n: string
  body: [
    line(
      "  " + .n + match(.req, true, "", false, "?") + ": "
      + match(.t, "string", "string", "integer", "number")
    )
  ]
})

%ts_record = emit(_, {
  match: name: string
  body: [
    line("")
    line("export interface " + .name + " {")
    emit(.fields, %ts_field)
    line("}")
  ]
})

out: file("types.ts", [
  line("// Code generated by aontu from model.aon. DO NOT EDIT.")
  emit($.records, %ts_record)
])
