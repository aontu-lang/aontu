# match-dispatch.aontu --- FAILED ATTEMPT, kept as evidence (README
# gap: no in-language discriminator dispatch). The idea: replace the
# plain union with a match() on the data's own `type` field, so a
# wrong payload would be reported against the ONE branch the
# discriminator selects instead of as a whole-union empty blob.
# `match` binds no hole, so the `_` scrutinee is one nothing binds:
# under `vet --at $.Event` the schema is refused before the data is
# read, verdict error, [aontu/hole_unbound] at $.Event. check.sh pins
# that. Consumers dispatch client-side instead
# (read `type`, vet --at $.registry.<type with dots underscored>).

Placed: close({ type:"order.placed" total_cents:integer & min(0) })

Paid: close({ type:"order.paid" amount_cents:integer & min(1) })

Event: match(
  _,
  { type:"order.placed" },
  $.Placed,
  { type:"order.paid" },
  $.Paid
)
