# orders-v1.aon --- order-service event contract, major version 1.
# The schema-registry document a producer publishes against and a
# consumer vets against. Entry file: includes the shared envelope,
# defines one closed shape per event type, the discriminated union,
# and the dispatch registry.

@"envelope.aon"

OrderPlaced: close($.Envelope & {
  type: "order.placed"
  payload: close({
    order_id: re("^ord-[0-9a-f]{8}$")
    customer_id: re("^cus-[0-9a-f]{8}$")
    # Money as integer cents; a float amount is a modelling error.
    total_cents: integer & min(0)
    currency: "EUR" | "USD" | "GBP"
    # Order lines: the element template is INLINE because a
    # referenced template inside a list spread does not resolve
    # under vet --at (pinned in use-case 03, gap 7).
    lines: [
      &: close({
        sku: re("^sku-[a-z0-9-]{4,40}$")
        qty: integer & min(1)
        unit_cents: integer & min(0)
      })
    ]
  })
})

OrderPaid: close($.Envelope & {
  type: "order.paid"
  payload: close({
    order_id: re("^ord-[0-9a-f]{8}$")
    payment_ref: re("^psp-[a-z0-9-]{4,40}$")
    amount_cents: integer & min(1)
    method: "card" | "sepa" | "paypal" | "invoice"
  })
})

OrderCancelled: close($.Envelope & {
  type: "order.cancelled"
  payload: close({
    order_id: re("^ord-[0-9a-f]{8}$")
    cancelled_by: "customer" | "merchant" | "system"
    note?: string
  })
})

# The stream contract: any one of the three shapes. The branch is
# discriminated by the pinned `type` field of each closed shape.
Event: $.OrderPlaced | $.OrderPaid | $.OrderCancelled

# Dispatch registry: wire type -> shape, for consumers that vet one
# branch at a time (--at $.registry.<key>). Keys are underscored
# because a key containing a dot ("order.placed") cannot be
# addressed by any CLI path spelling (pinned in check.sh); the
# consumer maps the wire string with tr '.' '_'.
registry: order_placed: $.OrderPlaced
registry: order_paid: $.OrderPaid
registry: order_cancelled: $.OrderCancelled
