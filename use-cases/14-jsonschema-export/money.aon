# money.aon --- the money wire convention crossing the export.
#
# Use-case 10's finding I (10-data-model/money-wire.aon has the full
# argument): exact money crosses JSON as a fixed-scale DECIMAL STRING
# plus a constant conversion mark, because `bigdecimal` itself has no
# JSON spelling. This file restates the two types self-contained and
# exports the wire record, to show both halves survive:
#
#   the string's re()   -> "pattern", checkable by any stock validator;
#   the `dec` mark      -> {"const": "bigdecimal:2", "type": "string"},
#                          outside `required`, so a consumer reading
#                          only the JSON Schema still learns the leaf
#                          and the scale.
#
# Contrast residue.aon, where a bare `bigdecimal` leaf is the loss the
# convention exists to avoid.

Dec2: type(string & re("^-?(0|[1-9][0-9]*)[.][0-9]{2}$") & neq("-0.00"))

Money: type(close({
  amount: $.Dec2
  currency: string & re("^[A-Z]{3}$") & neq("XXX", "XTS")
  dec?: "bigdecimal:2"
}))

# The wire record: strictly JSON-satisfiable, and the export target.
quote: $.Money
