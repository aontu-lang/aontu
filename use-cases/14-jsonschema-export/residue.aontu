# residue.aontu --- everything JSON Schema cannot say, in one report.
#
# The export's contract (reference-api.md): what does not cross is
# REPORTED to stderr, never dropped in silence -- a converter that
# quietly lost a constraint would hand its caller a schema that admits
# MORE than the model does. This document collects one instance of
# each loss class; check.sh pins the exported schema, every stderr
# line, and the --strict exit flip.
#
# What each field becomes (probed, not guessed):
#
#   total       must() is evaluate-only, and the engine holds the WHOLE
#               value residual, so the export is {} and the report says
#               `nil` -- the `number` bound beside it is lost too.
#   amountEur   bigdecimal exports as "number" with the exactness loss
#               reported; money.aontu is the convention that avoids this.
#   audit       hide() is omitted entirely, and reported: a consumer
#               is neither asked for it nor allowed to know about it.
#   annotations a spread template that reaches nothing outside itself
#               is read as the value it is, so its constraint crosses
#               as additionalProperties with nothing to report.
#   slugs       a template that reads its own key means a different
#               value at every key, so additionalProperties is {} and
#               the `&` entry is reported under `key`.
#   attempts    len() beside a list counts its items, so the bound
#               crosses as maxItems with nothing to report; a bare
#               len() with no bag or string beside it is the loss.

report: {
  total: number & must((v) => 0 <= v, "total must not be negative")
  amountEur: bigdecimal
  audit: hide("kept-off-the-wire")
  annotations: { &: string & len(max(63)) }
  slugs: { &: key(0) }
  attempts: [&: multiple(1)] & len(max(3))
}
