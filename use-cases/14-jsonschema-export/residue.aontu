# residue.aontu --- everything JSON Schema cannot say, in one report.
#
# The export's contract (reference-api.md): what does not cross is
# REPORTED to stderr, never dropped in silence -- a converter that
# quietly lost a constraint would hand its caller a schema that admits
# MORE than the model does. This document collects one instance of
# each loss class; check.sh pins the exported schema, every stderr
# line, and the --strict exit flip.
#
# What each field becomes (probed, not guessed):
#
#   total       must() is evaluate-only, so it is dropped and reported,
#               while the `number` kind beside it still crosses.
#   amountEur   bigdecimal exports as "number" and is reported: vet
#               reads JSON data as an integer or a float, never as the
#               exact leaf. money.aontu is the convention that avoids it.
#   audit       hide() is omitted entirely, and reported: a consumer
#               is neither asked for it nor allowed to know about it.
#   annotations a spread template carrying a constraint call stays
#               residual, so additionalProperties is {} and the `&`
#               entry is reported `unresolved`. (A bare-kind template,
#               registry.aontu's labels, crosses without loss.)
#   attempts    len() on a list crosses as minItems/maxItems; the
#               `integer` template is reported, because JSON reads 1
#               and 1.0 as one number and vet reads them as two leaves.

report: {
  total: number & must(min(0), "total must not be negative")
  amountEur: bigdecimal
  audit: hide("kept-off-the-wire")
  annotations: { &: string & len(max(63)) }
  attempts: [&: integer] & len(max(3))
}
