# An agent-emitted order record. An address is a path value (ADR-016),
# so the emitter writes Aontu: a plain string is never an address.
orders: {
  "ord-7003": {
    customerId: path("$.customers.cust-1002")
    status: "open"
    placed: "2026-08-20"
    lines: [
      {sku: "sku-valve-pro", qty: 1, unitCents: 4990, amountCents: 4990}
    ]
  }
}
