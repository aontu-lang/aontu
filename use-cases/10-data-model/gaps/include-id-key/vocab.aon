# Minimal repro, file 1 of 2: a schema whose record type references
# a named alias ($.schema.T), plus a bag spread that auto-names each
# record with id(key(0)). Evaluated DIRECTLY, this pattern works.
schema: {
  T: type(integer & min(1))
  Customer: type(close({ id: string, ledgerId: $.schema.T, name: string }))
}
customers: { &: id(key(0)) & $.schema.Customer & { id: .$KEY } }
