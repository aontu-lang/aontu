# xf-domain.aon --- the record schema as TypeScript, one transform.
#
# THE ACCEPTANCE CASE of the renderer's declaration lowering
# (docs/design/RENDER.0.md P5, G9 worked example 1): the schema below
# is walked into aontu:code records, and `aontu render` lowers them
# under the bundled TypeScript profile. Nine lines of transform;
# every construct exists today.
#
# TWO THINGS TO READ OFF IT. The schema is lifted with `type()`: the
# records are type()-marked, and a pack over an unmarked bag skips its
# marked children (the membership rule), so the bag itself is marked
# to say the children are wanted. And the optional keys -- `email?`,
# `creditLimitCents?` -- are ABSENT: an optional key with nothing to
# generate is not a member either, so a transform over a schema does
# not see them (use-cases/BUGS.md 86); xf-order.aon states optionality
# as data instead, which is what the render design asks of a
# transform.
@"./domain.aon"

step: hide(pack(type($.schema), {
  d: "export interface " + key(1) + " {\n"
    + join(
      pick(
        pack(_, {
          f: "  " + key(1) + ": "
            + match(
              _,
              integer, "number",
              biginteger, "bigint",
              string, "string",
              boolean, "boolean",
              [], "unknown[]",
              "unknown"
            )
            + ";"
        }),
        f
      ),
      "\n"
    )
    + "\n}"
}))

# ONE `line` HOLDING THE WHOLE FILE. A blank line SEPARATES the
# records, so the file is a join rather than a node per record: a
# `line` per record would need to know which one is last.
out: file("domain.ts", [line(join(pick($.step, d), "\n\n"))])
