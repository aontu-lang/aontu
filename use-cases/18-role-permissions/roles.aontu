# The role model: who may change which subtree of model.aontu. It is an
# aontu document, so the registry is close()d and every role follows
# one vocabulary. An entry is a path into the governed model, as
# `get` and `set` spell one; `*` matches any one key.

# A role: what it is for, the subtrees it may modify, and optionally
# the ones it may not. `aontu allow` meets the registry with the same
# shape as a spread, so a close()d vocabulary must declare `deny?`
# too, or the shape's optional key is refused as [aontu/closed].
Role: type(close({ desc:string allow:[&: string] deny?:[&: string] }))

# The registry is exhaustive: a role nobody declared is a located
# [aontu/closed] error, and an undeclared role may change nothing.
roles: close({
  &: $.Role
  admin: { desc:"Owns the whole model" allow:["$"] }
  dev: {
    desc: "Runs the services: scaling and deployment, never ownership or tier"
    allow: ["$.services" "$.deploy.*.replicas"]
    deny: ["$.services.*.tier" "$.services.*.owner"]
  }
  product: {
    desc: "Feature flags, and what a service says about itself"
    allow: ["$.features" "$.services.*.description"]
  }
  qa: { desc:"The test configuration" allow:["$.tests"] }
})
