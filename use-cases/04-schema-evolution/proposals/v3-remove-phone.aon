# STAGED PROPOSAL for v3: remove the phone field deprecated in 2.0.0.
# Against a CLOSED map the removal is visible as compat_narrowed; the
# gate's --allow-deprecated-removal downgrades exactly this finding,
# because v2 already deprecated the value: deprecate-then-remove is
# the sanctioned rename path.
aontu_policy: hide({compat: *backward | forward | full | none})
profile: close({
  id: string & re("^C[0-9]{7}$")
  email: string & re("^[^@ ]+@[^@ ]+[.][^@ ]+$")
  name: string & length(min(1))
  contact?: close({phone?: string & re("^[+][0-9]{7,15}$"), verified: *false | boolean})
  locale?: string & re("^[a-z][a-z](?:-[A-Z][A-Z])?$")
  tier: "standard" | "premium" | "enterprise"
  consent: close({marketing: *false | boolean, analytics: *false | boolean})
})
