# The service catalog: the single source of truth for WHAT runs.
# stack.aon pack()s this map into every environment, so a service
# added here appears in dev, staging and prod in the same commit --
# the per-environment blocks cannot drift from the catalog.
# Hidden: the catalog is an input, not deployment output.

fleet: hide({
  web: { tier:frontend port:8080 critical:false }
  auth: { tier:backend port:8081 critical:true }
  billing: { tier:backend port:8082 critical:true }
  reports: { tier:batch port:8083 critical:false }
})
