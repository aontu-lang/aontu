{
  "deploy": {
    "auth": {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "labels": {
          "app.kubernetes.io/managed-by": "aontu",
          "app.kubernetes.io/name": "auth"
        },
        "name": "auth",
        "namespace": "payments"
      },
      "spec": {
        "replicas": 2,
        "selector": {
          "matchLabels": {
            "app": "auth"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "auth"
            }
          },
          "spec": {
            "containers": [
              {
                "env": [
                  {
                    "name": "LOG_LEVEL",
                    "value": "info"
                  },
                  {
                    "name": "OTEL_EXPORTER_URL",
                    "value": "http://otel-collector.observability:4317"
                  },
                  {
                    "name": "OTEL_SERVICE_NAME",
                    "value": "auth"
                  }
                ],
                "image": "registry.acme.io/payments/auth:0.9.1",
                "name": "auth",
                "ports": [
                  {
                    "containerPort": 9090,
                    "name": "grpc",
                    "port": 9090,
                    "protocol": "TCP",
                    "targetPort": 9090
                  },
                  {
                    "containerPort": 8081,
                    "name": "http",
                    "port": 8081,
                    "protocol": "TCP",
                    "targetPort": 8081
                  }
                ],
                "resources": {
                  "limits": {
                    "cpu": "500m",
                    "memory": "512Mi"
                  },
                  "requests": {
                    "cpu": "250m",
                    "memory": "256Mi"
                  }
                },
                "restartPolicyy": "Always"
              }
            ]
          }
        }
      }
    },
    "billing": {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "labels": {
          "app.kubernetes.io/managed-by": "aontu",
          "app.kubernetes.io/name": "billing"
        },
        "name": "billing",
        "namespace": "payments"
      },
      "spec": {
        "replicas": 6,
        "selector": {
          "matchLabels": {
            "app": "billing"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "billing"
            }
          },
          "spec": {
            "containers": [
              {
                "env": [
                  {
                    "name": "LOG_LEVEL",
                    "value": "debug"
                  },
                  {
                    "name": "OTEL_EXPORTER_URL",
                    "value": "http://otel-collector.observability:4317"
                  },
                  {
                    "name": "OTEL_SERVICE_NAME",
                    "value": "billing"
                  }
                ],
                "image": "registry.acme.io/payments/billing:2.0.0",
                "name": "billing",
                "ports": [
                  {
                    "containerPort": 8082,
                    "name": "http",
                    "port": 8082,
                    "protocol": "TCP",
                    "targetPort": 8082
                  }
                ],
                "resources": {
                  "limits": {
                    "cpu": "2000m",
                    "memory": "2048Mi"
                  },
                  "requests": {
                    "cpu": "1000m",
                    "memory": "1024Mi"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "web": {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "labels": {
          "app.kubernetes.io/managed-by": "aontu",
          "app.kubernetes.io/name": "web"
        },
        "name": "web",
        "namespace": "payments"
      },
      "spec": {
        "replicas": 2,
        "selector": {
          "matchLabels": {
            "app": "web"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "web"
            }
          },
          "spec": {
            "containers": [
              {
                "env": [
                  {
                    "name": "LOG_LEVEL",
                    "value": "info"
                  },
                  {
                    "name": "OTEL_EXPORTER_URL",
                    "value": "http://otel-collector.observability:4317"
                  },
                  {
                    "name": "OTEL_SERVICE_NAME",
                    "value": "web"
                  }
                ],
                "image": "registry.acme.io/payments/web:1.4.2",
                "name": "web",
                "ports": [
                  {
                    "containerPort": 8080,
                    "name": "http",
                    "port": 8080,
                    "protocol": "TCP",
                    "targetPort": 8080
                  }
                ],
                "resources": {
                  "limits": {
                    "cpu": "750m",
                    "memory": "512Mi"
                  },
                  "requests": {
                    "cpu": "250m",
                    "memory": "256Mi"
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "service": {
    "auth": {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "auth",
        "namespace": "payments"
      },
      "spec": {
        "ports": [
          {
            "containerPort": 9090,
            "name": "grpc",
            "port": 9090,
            "protocol": "TCP",
            "targetPort": 9090
          },
          {
            "containerPort": 8081,
            "name": "http",
            "port": 8081,
            "protocol": "TCP",
            "targetPort": 8081
          }
        ],
        "selector": {
          "app": "auth"
        }
      }
    },
    "billing": {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "billing",
        "namespace": "payments"
      },
      "spec": {
        "ports": [
          {
            "containerPort": 8082,
            "name": "http",
            "port": 8082,
            "protocol": "TCP",
            "targetPort": 8082
          }
        ],
        "selector": {
          "app": "billing"
        }
      }
    },
    "web": {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "web",
        "namespace": "payments"
      },
      "spec": {
        "ports": [
          {
            "containerPort": 8080,
            "name": "http",
            "port": 8080,
            "protocol": "TCP",
            "targetPort": 8080
          }
        ],
        "selector": {
          "app": "web"
        }
      }
    }
  }
}