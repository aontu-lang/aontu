# 2026-08-26: FIXED by the template-clone isolation change (ADR-005) —
# a ranked default computed from key() inside an each template under
# pack now evaluates per destination: every service gets its own name.
# Historically the rank-2 preference shared its one inner key() and
# every service got the FIRST service's name, exit 0, silently wrong
# (why OTEL_SERVICE_NAME was injected in internal.envmaps instead).
# Golden: expected/pref-key-crosswire.json (web and auth each carry
# their own value).  Shared spec pin: test/spec/gen-pack.tsv
# pack-rankpref-key-per-child.
col: { web: {}, auth: {} }
shared: { X: { name: X } }
out: pack($.col, { env: each($.shared, { value: **key(3) | string }) })
