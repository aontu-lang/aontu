# FIXED 2026-08-27 (the review's finding C, BUGS.md sec 16): this
# model is valid and now EVALUATES. A lower bound violated is
# provisional -- more members may still arrive -- so the atom
# residuates and is decided at generation, by which time the second
# pack has merged the port in. Kept as the regression guard, with
# expected/length-on-schema-list.json as its golden.
#
# FAILED ATTEMPT: require at least one port per service on the skeleton.
# The generated ports list HAS one element (merged by the second pack),
# but length(min(1)) is checked against the spread-only schema list
# (0 members) before the merge -- a false refusal of a valid model.
# [aontu/constraint], exit 1.  (Length next to already-present elements
# in one file works fine; the failure needs the generator merge.)
names: [web]
col: { web: { http: { containerPort: 8080 } } }
deploy: pack($.names, { ports: [ &: { containerPort: integer } ] & length(min(1)) })
deploy: pack($.col, { ports: each(_) })
