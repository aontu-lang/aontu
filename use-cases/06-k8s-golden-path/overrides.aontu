# Reviewed exceptions, written at the concrete generated paths.
# Composition onto pack-generated children works exactly like editing
# plain data: a concrete value beats a ranked default, everything else
# is untouched.

deploy: {
  billing: spec: replicas: 6 # peak-season capacity
  web: spec: template: spec: containers: [
    resources: limits: cpu: "750m" # one field; memory default survives
  ]
}
