# corp.example platform team: the service deployment contract, v1.4.2.
# Deliberately self-contained: no cross-key references, because a module
# imported at a nested key cannot resolve its own $.-refs (see README,
# "Module-internal references").  close() so consumers cannot invent
# fields the platform does not operate.
spec: close({
  name: string & re("^[a-z][a-z0-9-]{2,39}$")
  owner: string & re("^[a-z0-9.-]+@corp[.]example$")
  tier: "critical" | "standard" | *"internal"
  port: *8080 | (integer & min(1024) & max(65535))
  replicas: *2 | (integer & min(1) & max(64))
  healthcheck: {
    path: *"/healthz" | (string & re("^/"))
    interval_seconds: *15 | (integer & min(5) & max(300))
  }
  telemetry: {
    metrics: *true | boolean
    traces: *false | boolean
  }
})
