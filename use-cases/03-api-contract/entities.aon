# entities.aon --- the two resources the API serves. close() makes
# each entity's key set part of the contract. NOT hide()-marked:
# vetting --at a marked subtree silently skips required-field checks
# (README, gap 2), and these are vet anchors.

entities: {

  User: close({
    id:         $.types.UserId
    email:      $.types.Email
    name:       $.types.DisplayName
    role:       $.types.Role
    status:     "active" | "invited" | "suspended"
    created_at: $.types.Timestamp
    # Optional: present only once the user uploaded one / signed in.
    avatar_url?:   re("^https://[A-Za-z0-9.-]+/")
    last_seen_at?: $.types.Timestamp
  })

  Project: close({
    id:           $.types.ProjectId
    slug:         $.types.Slug
    name:         $.types.DisplayName
    owner_id:     $.types.UserId
    visibility:   $.types.Visibility
    archived:     boolean
    member_count: integer & min(0)
    created_at:   $.types.Timestamp
  })
}
