# errors.aon --- the single error envelope every non-2xx response uses.
# Unmarked, like entities.aon: it is a vet anchor (README, gap 2).

errors: Envelope: close({
  error: close({
    code: "invalid_request" | "unauthorized" | "forbidden"
      | "not_found" | "conflict" | "rate_limited" | "internal"
    message: string & length(min(1) & max(200))
    request_id: $.types.RequestId
    # Field-level details. The element template is written INLINE:
    # a $.ref inside a list spread fails under `vet --at`
    # (README, gap 1), so referencing a shared Detail shape here
    # would make the envelope unvettable.
    details?: [&: close({ field:string reason:string })]
  })
})
