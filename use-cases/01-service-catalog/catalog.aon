# catalog.aon --- THE CATALOG VIEW: what each service IS -- ownership,
# tier, purpose, dependencies. This view is the one the deployment view
# (deploy.aon) REFERENCES, so the two meet field-by-field at the deploy
# positions. dependedOnBy (the inverse of dependsOn) is written BY HAND
# on every target: `aontu relations` checks it, nothing derives it
# (gap 4). Every address is a tree path (ADR-014).
catalog: domains: {
  payments: {
    team: "team-payments"
    services: {
      &: $.spec.CatalogEntry & { owner:"team-payments" }
      payments: {
        tier: 1
        description: "Card payment orchestration and capture API."
        dependsOn: [
          path($.catalog.domains.payments.services.ledger)
          path($.catalog.domains.payments.services.risk)
          path($.catalog.domains.identity.services.auth)
          path($.catalog.domains.platform.services.notify)
        ]
        dependedOnBy: [path($.catalog.domains.platform.services.gateway)]
      }
      ledger: tier: 1
      ledger: description: "Double-entry ledger of record for money movement."
      ledger: dependedOnBy: [path($.catalog.domains.payments.services.payments)]
      risk: tier: 2
      risk: description: "Transaction risk scoring and fraud rules engine."
      risk: dependsOn: [path($.catalog.domains.identity.services.directory)]
      risk: dependedOnBy: [path($.catalog.domains.payments.services.payments)]
    }
  }
  identity: {
    team: "team-identity"
    services: {
      &: $.spec.CatalogEntry & { owner:"team-identity" }
      auth: {
        tier: 1
        description: "OAuth2 token issuing and session verification."
        dependsOn: [path($.catalog.domains.identity.services.directory)]
        dependedOnBy: [
          path($.catalog.domains.platform.services.gateway)
          path($.catalog.domains.payments.services.payments)
        ]
      }
      directory: {
        tier: 2
        description: "Employee and customer directory lookups."
        dependedOnBy: [
          path($.catalog.domains.payments.services.risk)
          path($.catalog.domains.identity.services.auth)
        ]
      }
    }
  }
  platform: {
    team: "team-platform"
    services: {
      &: $.spec.CatalogEntry & { owner:"team-platform" }
      gateway: {
        tier: 1
        description: "Public API edge gateway and request routing."
        dependsOn: [
          path($.catalog.domains.payments.services.payments)
          path($.catalog.domains.identity.services.auth)
        ]
      }
      notify: tier: 3
      notify: lifecycle: experimental
      notify: description: "Customer notification fan-out orchestration."
      notify: dependsOn: [path($.catalog.domains.platform.services.email)]
      notify: dependedOnBy: [path($.catalog.domains.payments.services.payments)]
      email: tier: 3
      email: description: "SMTP delivery with bounce and complaint tracking."
      email: dependedOnBy: [path($.catalog.domains.platform.services.notify)]
    }
  }
}
