# catalog.aon --- THE CATALOG VIEW: what each service IS -- ownership,
# tier, purpose, dependencies. This view is the one the deployment view
# (deploy.aon) REFERENCES, so the two meet field-by-field at the deploy
# positions. dependedOnBy (the inverse of dependsOn) is written BY HAND
# on every target: `aontu relations` checks it, nothing derives it
# (gap 4). Every address is a tree path (ADR-013).
catalog: domains: {
  payments: {
    team: "team-payments"
    services: {
      &: $.spec.CatalogEntry & {owner: "team-payments"}
      payments: {
        tier: 1
        description: "Card payment orchestration and capture API."
        dependsOn: [
          "$.catalog.domains.payments.services.ledger"
          "$.catalog.domains.payments.services.risk"
          "$.catalog.domains.identity.services.auth"
          "$.catalog.domains.platform.services.notify"
        ]
        dependedOnBy: ["$.catalog.domains.platform.services.gateway"]
      }
      ledger: {
        tier: 1
        description: "Double-entry ledger of record for money movement."
        dependedOnBy: ["$.catalog.domains.payments.services.payments"]
      }
      risk: {
        tier: 2
        description: "Transaction risk scoring and fraud rules engine."
        dependsOn: ["$.catalog.domains.identity.services.directory"]
        dependedOnBy: ["$.catalog.domains.payments.services.payments"]
      }
    }
  }
  identity: {
    team: "team-identity"
    services: {
      &: $.spec.CatalogEntry & {owner: "team-identity"}
      auth: {
        tier: 1
        description: "OAuth2 token issuing and session verification."
        dependsOn: ["$.catalog.domains.identity.services.directory"]
        dependedOnBy: [
          "$.catalog.domains.platform.services.gateway"
          "$.catalog.domains.payments.services.payments"
        ]
      }
      directory: {
        tier: 2
        description: "Employee and customer directory lookups."
        dependedOnBy: [
          "$.catalog.domains.payments.services.risk"
          "$.catalog.domains.identity.services.auth"
        ]
      }
    }
  }
  platform: {
    team: "team-platform"
    services: {
      &: $.spec.CatalogEntry & {owner: "team-platform"}
      gateway: {
        tier: 1
        description: "Public API edge gateway and request routing."
        dependsOn: [
          "$.catalog.domains.payments.services.payments"
          "$.catalog.domains.identity.services.auth"
        ]
      }
      notify: {
        tier: 3
        lifecycle: experimental
        description: "Customer notification fan-out orchestration."
        dependsOn: ["$.catalog.domains.platform.services.email"]
        dependedOnBy: ["$.catalog.domains.payments.services.payments"]
      }
      email: {
        tier: 3
        description: "SMTP delivery with bounce and complaint tracking."
        dependedOnBy: ["$.catalog.domains.platform.services.notify"]
      }
    }
  }
}
