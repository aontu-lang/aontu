# proposals/onboard-webhooks.aon --- an AI agent proposed a new
# service; this entry unifies its raw JSON candidate into the live
# model, where the full CatalogEntry schema and refer() checks apply.
# The JSON is loaded at its own hidden key and pulled in by reference:
# `... & @"../data/x.json"` written inline fails with
# [aontu/mapval_spread_required] (README, gap 2).
#
# The proposal lands INSIDE the catalog, at the path it is proposing
# to occupy: an address is a tree path (ADR-014), so a new service is
# a new position, and the edges naming it name that position.
@"../system.aon"

candidate: hide(@"../data/candidate-webhooks.json")

catalog: domains: platform: services: {
  webhooks: $.spec.CatalogEntry & $.candidate & {
    dependsOn: [
      "$.catalog.domains.identity.services.auth"
      "$.catalog.domains.platform.services.email"
    ]
  }

  # The inverse edges the proposal implies, so `aontu relations`
  # passes. WORKAROUND (README, gap 4): lists unify positionally, so
  # "append" must restate the existing elements verbatim, in order.
  email: {
    dependedOnBy: [
      "$.catalog.domains.platform.services.notify"
      "$.catalog.domains.platform.services.webhooks"
    ]
  }
}
catalog: domains: identity: services: auth: {
  dependedOnBy: [
    "$.catalog.domains.platform.services.gateway"
    "$.catalog.domains.payments.services.payments"
    "$.catalog.domains.platform.services.webhooks"
  ]
}
