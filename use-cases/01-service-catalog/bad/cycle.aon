# bad/cycle.aon --- change request CR-4711: ledger gains a callback
# into payments. The dependsOn relation declares acyclic() (spec.aon),
# so GENERATION refuses the loop payments -> ledger -> payments with a
# located relation_cycle -- the atoms decide at generation, where every
# edge is known -- and `aontu relations` reports the same finding.
@"../system.aon"

catalog: domains: payments: services: ledger: {
  dependsOn: ["$.catalog.domains.payments.services.payments"]
}
