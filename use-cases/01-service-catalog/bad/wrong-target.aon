# bad/wrong-target.aon --- the declared endpoint type, violated, where
# the DATA does not repeat it.
#
# `rel($.std.Service)` on the hostedOn field says every hostedOn edge
# must land on a $.std.Service -- declared ONCE, at the field, and the
# type FLOWS into each target (RELATIONS.0.md P2; the old root-level
# `relations:` target declaration is gone with the magic key). The far
# end is a host, not a service, so the flow is an ordinary located
# kind conflict: EVALUATION refuses, and `aontu relations` answers
# `verdict: error` for a document that does not stand up.
@"../system.aon"

infra: {
  bastion: id(svc_bastion) & { kind: host, name: "bastion-eu1" }
  runner: id(svc_runner) & { hostedOn: rel($.std.Service) & [svc_bastion] }
}
