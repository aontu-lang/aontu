# bad/cycle.aontu --- change request CR-4711: ledger gains a callback
# into payments. The dependsOn relation declares acyclic() (spec.aontu),
# so GENERATION refuses the loop payments -> ledger -> payments with a
# located relation_cycle -- the atoms decide at generation, where every
# edge is known -- and `aontu relations` reports the same finding.
@"../system.aontu"

catalog: domains: payments: services: ledger: dependsOn: [
  path($.catalog.domains.payments.services.payments)
]
