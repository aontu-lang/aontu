# deploy.aon --- THE DEPLOYMENT VIEW: what each cluster RUNS. The same
# eight services as catalog.aon, laid out by region and cluster. Each
# workload REFERENCES the ORG FACTS of its catalog entry -- owner and
# tier -- so the two views meet on those and a contradiction between
# them is a located error (see bad/tier-conflict.aon). It references
# the facts rather than the whole entry deliberately: the dependency
# graph is a fact about the CATALOG, and restating it at every cluster
# would duplicate every edge at a position that has no business
# owning one. The reference is directional -- the catalog is not
# changed by what a cluster runs -- which is what lets this file be
# one of several deployment views over one catalog.
deploy: regions: {
  eu1: clusters: {
    core: workloads: {
      &: $.spec.Workload
      payments: owner: $.catalog.domains.payments.services.payments.owner
      payments: tier: $.catalog.domains.payments.services.payments.tier

      payments: image: "registry.acme.internal/payments:2.14.1"
      payments: replicas: 6
      payments: ports: http: { number:8080 protocol:http }
      ledger: owner: $.catalog.domains.payments.services.ledger.owner
      ledger: tier: $.catalog.domains.payments.services.ledger.tier

      ledger: image: "registry.acme.internal/ledger:1.9.0"
      ledger: replicas: 3
      ledger: ports: grpc: { number:9443 protocol:grpc }
      risk: owner: $.catalog.domains.payments.services.risk.owner
      risk: tier: $.catalog.domains.payments.services.risk.tier

      risk: image: "registry.acme.internal/risk:0.31.2"
      risk: ports: grpc: { number:9443 protocol:grpc }
      auth: owner: $.catalog.domains.identity.services.auth.owner
      auth: tier: $.catalog.domains.identity.services.auth.tier

      auth: image: "registry.acme.internal/auth:5.2.0"
      auth: replicas: 4
      auth: ports: http: { number:8443 protocol:https }
      directory: owner: $.catalog.domains.identity.services.directory.owner
      directory: tier: $.catalog.domains.identity.services.directory.tier

      directory: image: "registry.acme.internal/directory:3.0.4"
      directory: ports: http: { number:8080 protocol:http }
    }
    edge: workloads: {
      &: $.spec.Workload
      gateway: owner: $.catalog.domains.platform.services.gateway.owner
      gateway: tier: $.catalog.domains.platform.services.gateway.tier

      gateway: image: "registry.acme.internal/gateway:4.7.3"
      gateway: replicas: 8
      gateway: ports: public: { number:443 protocol:https }
      gateway: ports: admin: { number:9901 protocol:http direction:inout }
    }
  }
  us1: clusters: comms: workloads: {
    &: $.spec.Workload
    notify: owner: $.catalog.domains.platform.services.notify.owner
    notify: tier: $.catalog.domains.platform.services.notify.tier

    notify: image: "registry.acme.internal/notify:0.12.0"
    notify: ports: http: { number:8080 protocol:http }
    email: owner: $.catalog.domains.platform.services.email.owner
    email: tier: $.catalog.domains.platform.services.email.tier

    email: image: "registry.acme.internal/email:2.2.7"
    email: ports: smtp: { number:2525 protocol:smtp direction:out }
  }
}
