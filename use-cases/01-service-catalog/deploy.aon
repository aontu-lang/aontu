# deploy.aon --- THE DEPLOYMENT VIEW: what each cluster RUNS. The same
# eight entities as catalog.aon, named by the same id(svc_<name>), laid
# out by region and cluster. The two trees never mention each other's
# paths; identity alone joins them (see bad/tier-conflict.aon).
deploy: regions: {
  eu1: clusters: {
    core: workloads: {
      &: $.spec.Workload
      payments: id(svc_payments) & {
        image: "registry.acme.internal/payments:2.14.1"
        replicas: 6
        ports: {http: {number: 8080, protocol: http}}
      }
      ledger: id(svc_ledger) & {
        image: "registry.acme.internal/ledger:1.9.0"
        replicas: 3
        ports: {grpc: {number: 9443, protocol: grpc}}
      }
      risk: id(svc_risk) & {
        image: "registry.acme.internal/risk:0.31.2"
        ports: {grpc: {number: 9443, protocol: grpc}}
      }
      auth: id(svc_auth) & {
        image: "registry.acme.internal/auth:5.2.0"
        replicas: 4
        ports: {http: {number: 8443, protocol: https}}
      }
      directory: id(svc_directory) & {
        image: "registry.acme.internal/directory:3.0.4"
        ports: {http: {number: 8080, protocol: http}}
      }
    }
    edge: workloads: {
      &: $.spec.Workload
      gateway: id(svc_gateway) & {
        image: "registry.acme.internal/gateway:4.7.3"
        replicas: 8
        ports: {
          public: {number: 443, protocol: https}
          admin: {number: 9901, protocol: http, direction: inout}
        }
      }
    }
  }
  us1: clusters: {
    comms: workloads: {
      &: $.spec.Workload
      notify: id(svc_notify) & {
        image: "registry.acme.internal/notify:0.12.0"
        ports: {http: {number: 8080, protocol: http}}
      }
      email: id(svc_email) & {
        image: "registry.acme.internal/email:2.2.7"
        ports: {smtp: {number: 2525, protocol: smtp, direction: out}}
      }
    }
  }
}
