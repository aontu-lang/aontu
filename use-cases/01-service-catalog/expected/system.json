{
  "catalog": {
    "domains": {
      "identity": {
        "services": {
          "auth": {
            "dependedOnBy": [
              "$.catalog.domains.platform.services.gateway",
              "$.catalog.domains.payments.services.payments"
            ],
            "dependsOn": [
              "$.catalog.domains.identity.services.directory"
            ],
            "description": "OAuth2 token issuing and session verification.",
            "kind": "service",
            "lifecycle": "production",
            "owner": "team-identity",
            "tier": 1
          },
          "directory": {
            "dependedOnBy": [
              "$.catalog.domains.payments.services.risk",
              "$.catalog.domains.identity.services.auth"
            ],
            "description": "Employee and customer directory lookups.",
            "kind": "service",
            "lifecycle": "production",
            "owner": "team-identity",
            "tier": 2
          }
        },
        "team": "team-identity"
      },
      "payments": {
        "services": {
          "ledger": {
            "dependedOnBy": [
              "$.catalog.domains.payments.services.payments"
            ],
            "description": "Double-entry ledger of record for money movement.",
            "kind": "service",
            "lifecycle": "production",
            "owner": "team-payments",
            "tier": 1
          },
          "payments": {
            "dependedOnBy": [
              "$.catalog.domains.platform.services.gateway"
            ],
            "dependsOn": [
              "$.catalog.domains.payments.services.ledger",
              "$.catalog.domains.payments.services.risk",
              "$.catalog.domains.identity.services.auth",
              "$.catalog.domains.platform.services.notify"
            ],
            "description": "Card payment orchestration and capture API.",
            "kind": "service",
            "lifecycle": "production",
            "owner": "team-payments",
            "tier": 1
          },
          "risk": {
            "dependedOnBy": [
              "$.catalog.domains.payments.services.payments"
            ],
            "dependsOn": [
              "$.catalog.domains.identity.services.directory"
            ],
            "description": "Transaction risk scoring and fraud rules engine.",
            "kind": "service",
            "lifecycle": "production",
            "owner": "team-payments",
            "tier": 2
          }
        },
        "team": "team-payments"
      },
      "platform": {
        "services": {
          "email": {
            "dependedOnBy": [
              "$.catalog.domains.platform.services.notify"
            ],
            "description": "SMTP delivery with bounce and complaint tracking.",
            "kind": "service",
            "lifecycle": "production",
            "owner": "team-platform",
            "tier": 3
          },
          "gateway": {
            "dependsOn": [
              "$.catalog.domains.payments.services.payments",
              "$.catalog.domains.identity.services.auth"
            ],
            "description": "Public API edge gateway and request routing.",
            "kind": "service",
            "lifecycle": "production",
            "owner": "team-platform",
            "tier": 1
          },
          "notify": {
            "dependedOnBy": [
              "$.catalog.domains.payments.services.payments"
            ],
            "dependsOn": [
              "$.catalog.domains.platform.services.email"
            ],
            "description": "Customer notification fan-out orchestration.",
            "kind": "service",
            "lifecycle": "experimental",
            "owner": "team-platform",
            "tier": 3
          }
        },
        "team": "team-platform"
      }
    }
  },
  "deploy": {
    "regions": {
      "eu1": {
        "clusters": {
          "core": {
            "workloads": {
              "auth": {
                "image": "registry.acme.internal/auth:5.2.0",
                "kind": "service",
                "owner": "team-identity",
                "ports": {
                  "http": {
                    "direction": "in",
                    "number": 8443,
                    "protocol": "https"
                  }
                },
                "replicas": 4,
                "tier": 1
              },
              "directory": {
                "image": "registry.acme.internal/directory:3.0.4",
                "kind": "service",
                "owner": "team-identity",
                "ports": {
                  "http": {
                    "direction": "in",
                    "number": 8080,
                    "protocol": "http"
                  }
                },
                "replicas": 2,
                "tier": 2
              },
              "ledger": {
                "image": "registry.acme.internal/ledger:1.9.0",
                "kind": "service",
                "owner": "team-payments",
                "ports": {
                  "grpc": {
                    "direction": "in",
                    "number": 9443,
                    "protocol": "grpc"
                  }
                },
                "replicas": 3,
                "tier": 1
              },
              "payments": {
                "image": "registry.acme.internal/payments:2.14.1",
                "kind": "service",
                "owner": "team-payments",
                "ports": {
                  "http": {
                    "direction": "in",
                    "number": 8080,
                    "protocol": "http"
                  }
                },
                "replicas": 6,
                "tier": 1
              },
              "risk": {
                "image": "registry.acme.internal/risk:0.31.2",
                "kind": "service",
                "owner": "team-payments",
                "ports": {
                  "grpc": {
                    "direction": "in",
                    "number": 9443,
                    "protocol": "grpc"
                  }
                },
                "replicas": 2,
                "tier": 2
              }
            }
          },
          "edge": {
            "workloads": {
              "gateway": {
                "image": "registry.acme.internal/gateway:4.7.3",
                "kind": "service",
                "owner": "team-platform",
                "ports": {
                  "admin": {
                    "direction": "inout",
                    "number": 9901,
                    "protocol": "http"
                  },
                  "public": {
                    "direction": "in",
                    "number": 443,
                    "protocol": "https"
                  }
                },
                "replicas": 8,
                "tier": 1
              }
            }
          }
        }
      },
      "us1": {
        "clusters": {
          "comms": {
            "workloads": {
              "email": {
                "image": "registry.acme.internal/email:2.2.7",
                "kind": "service",
                "owner": "team-platform",
                "ports": {
                  "smtp": {
                    "direction": "out",
                    "number": 2525,
                    "protocol": "smtp"
                  }
                },
                "replicas": 2,
                "tier": 3
              },
              "notify": {
                "image": "registry.acme.internal/notify:0.12.0",
                "kind": "service",
                "owner": "team-platform",
                "ports": {
                  "http": {
                    "direction": "in",
                    "number": 8080,
                    "protocol": "http"
                  }
                },
                "replicas": 2,
                "tier": 3
              }
            }
          }
        }
      }
    }
  }
}
