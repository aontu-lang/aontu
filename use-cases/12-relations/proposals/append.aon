# proposals/append.aon --- a proposal appends a consumer to an
# EXISTING list from a separate position. The schema's rel() rewrote
# the catalog list once, and the rewrite installed its leaf constraint
# as the list's element spread -- so the element arriving here is
# converted exactly as the originals were, its inverse is written out,
# and the whole model still generates.
# (Lists unify positionally, so the append restates the existing
# elements verbatim, in order -- the same workaround use-case 01
# records.)
@"../model.aon"

pipeline: jobs: {
  archive: id(job_archive) & {
    cmd: "cold --store"
    fedBy: [job_transform]
  }
}
change: id(job_transform) & {
  feeds: [job_load, job_audit, job_archive]
}
