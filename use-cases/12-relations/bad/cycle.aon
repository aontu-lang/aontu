# bad/cycle.aon --- a change makes load feed extract: the DAG closes
# into a loop. feeds declares acyclic() (spec.aon), so GENERATION
# refuses with a located relation_cycle at an edge on the loop, and
# `aontu relations` reports the same finding.
@"../model.aon"

pipeline: jobs: {
  load:    { feeds: ["$.pipeline.jobs.extract"] }
  extract: { fedBy: ["$.pipeline.jobs.load"] }
}
