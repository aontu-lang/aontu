# pipeline.aon --- the ETL topology: which job feeds which. Both
# directions are written out -- deriving the inverse FOR the author is
# generation, not validation, and inverse() only checks -- and every
# list is a plain list of names: the schema's rel() converts them.
pipeline: jobs: {
  &: $.spec.Job

  extract: id(job_extract) & {
    cmd: "fetch --source api"
    feeds: [job_transform]
  }

  transform: id(job_transform) & {
    cmd: "clean --dedup"
    fedBy: [job_extract]
    feeds: [job_load, job_audit]
  }

  load: id(job_load) & {
    cmd: "warehouse --commit"
    fedBy: [job_transform]
  }

  audit: id(job_audit) & {
    cmd: "report --daily"
    fedBy: [job_transform]
  }
}
