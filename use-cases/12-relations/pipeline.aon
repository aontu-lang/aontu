# pipeline.aon --- the ETL topology: which job feeds which. Both
# directions are written out -- deriving the inverse FOR the author is
# generation, not validation, and inverse() only checks -- and every
# list is a plain list of addresses: the schema's rel() checks them.
pipeline: jobs: {
  &: $.spec.Job

  extract: {
    cmd: "fetch --source api"
    feeds: [path($.pipeline.jobs.transform)]
  }

  transform: {
    cmd: "clean --dedup"
    fedBy: [path($.pipeline.jobs.extract)]
    feeds: [path($.pipeline.jobs.load), path($.pipeline.jobs.audit)]
  }

  load: {
    cmd: "warehouse --commit"
    fedBy: [path($.pipeline.jobs.transform)]
  }

  audit: {
    cmd: "report --daily"
    fedBy: [path($.pipeline.jobs.transform)]
  }
}
