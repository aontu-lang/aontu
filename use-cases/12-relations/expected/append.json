{
  "pipeline": {
    "jobs": {
      "archive": {
        "cmd": "cold --store",
        "fedBy": [
          "$.pipeline.jobs.transform"
        ],
        "kind": "job"
      },
      "audit": {
        "cmd": "report --daily",
        "fedBy": [
          "$.pipeline.jobs.transform"
        ],
        "kind": "job"
      },
      "extract": {
        "cmd": "fetch --source api",
        "feeds": [
          "$.pipeline.jobs.transform"
        ],
        "kind": "job"
      },
      "load": {
        "cmd": "warehouse --commit",
        "fedBy": [
          "$.pipeline.jobs.transform"
        ],
        "kind": "job"
      },
      "transform": {
        "cmd": "clean --dedup",
        "fedBy": [
          "$.pipeline.jobs.extract"
        ],
        "feeds": [
          "$.pipeline.jobs.load",
          "$.pipeline.jobs.audit",
          "$.pipeline.jobs.archive"
        ],
        "kind": "job"
      }
    }
  }
}
