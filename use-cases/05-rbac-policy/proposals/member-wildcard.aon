# Agent-emitted proposal: give the (unprivileged) member role the
# wildcard grant. The unprivileged branch of the Role shape excludes
# admin_all from every grant via neq() on the list spread, so this is
# a located [aontu/constraint] error at the offending element.
@"../roles.aon"
roles: member: grants: ["$.permissions.project_read", "$.permissions.project_write", "$.permissions.member_read", "$.permissions.admin_all"]
