@"../tenant.aon"

# VIOLATION: two members hold the owner role. The exactly_one_owner
# invariant (filter+length, same-layer) must refuse this document.
tenant: name: "Acme Rockets"
tenant: slug: "acme-rockets"
tenant: plan: free
tenant: entitlement: { plan:free sso:false scim:false auditLog:false }
tenant: members: ada: role: path($.roles.owner)
tenant: members: grace: role: path($.roles.owner)
tenant: members: alan: { role:path($.roles.auditor) invitedBy:ada }
tenant: security: { mfaRequired:true sessionTimeoutMinutes:480 }

audit: hide({
  exactly_one_owner: length(1) & filter($.tenant.members, {
    role: path($.roles.owner)
  })
  seats_within_plan: length(max($.tenant.limits.maxSeats)) & $.tenant.members
  mfa_mandatory: must(
    { mfaRequired:true },
    "corporate policy CP-114: MFA is mandatory for every tenant"
  ) & $.tenant.security
})
