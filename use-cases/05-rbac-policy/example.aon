@"tenant.aon"

# A concrete tenant composed with the schema: the whole model
# evaluates to one JSON document -- catalog, role registry and tenant,
# with limits_supportTier derived by match() and defaultMemberRole
# supplied by its preference.
tenant: name: "Acme Rockets"
tenant: slug: "acme-rockets"
tenant: plan: free
tenant: entitlement: { plan:free sso:false scim:false auditLog:false }
tenant: members: ada: role: path($.roles.owner)
tenant: members: grace: role: path($.roles.member)
tenant: members: alan: { role:path($.roles.auditor) invitedBy:ada }
tenant: security: { mfaRequired:true sessionTimeoutMinutes:480 }
