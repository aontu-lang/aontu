# Attempted repair: keep the default, add a must() backstop for the
# closed set. Under vet this DOES refuse "superadmin" (the must-
# carrying branch dies, the scalar branches die, |:empty). But the
# conjunct kills the default: standalone evaluation now FAILS (the
# documented G1 phase-1 limit -- a preference meeting a constraint in
# a conjunct does not resolve to the default). So this spelling
# trades away generation instead of enforcement.
invite: { role: (*member | member | admin | owner)
                & must(member | admin | owner,
                       "role must be one of: member, admin, owner") }
