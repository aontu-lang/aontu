# Use-case 01 gap 8 (claim C1, refer($.std.Service) half): the language
# reference's own example for refer(t) — `[&: refer($.std.Service), ...]`
# (reference-language.md, function table) — dies of unify_cycle when the
# REFERRING entity is id-merged across two views whose shared schema
# carries a referenced ports template.  The target (svc/ledger) carries
# no ports at all; the failure names an integer meeting ITSELF.
# Controls that pass on this exact document: refer() bare, and
# refer({kind: service}) with the type written out literally — so the
# cycle comes from the type argument being a REFERENCE, not from the
# constraint it denotes.
# expected: exit 0 (same result refer({kind: service}) produces)
# actual:   [aontu/unify_cycle]: Cannot unify values at path
#           $.deploy.workloads.pay.dependsOn.0.ports.number
#           (Cannot unify value: integer with value: integer) exit 1
@"std/system"
spec: hide({
  PortSpec: $.std.Port & {number: integer}
  Entry: $.std.Service & {
    ports?: {&: $.spec.PortSpec}
    dependsOn?: [&: refer($.std.Service)]
  }
})
catalog: services: {
  &: $.spec.Entry
  pay: id(svc/pay) & { dependsOn: [svc/ledger] }
  ledger: id(svc/ledger) & {}
}
deploy: workloads: {
  &: $.spec.Entry
  pay: id(svc/pay) & { ports: {http: {number: 8080}} }
}
