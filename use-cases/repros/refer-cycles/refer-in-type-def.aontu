# Use-case 10 gap 7 (claim C2, single-file half): relate() written inside
# a named type() definition — the obvious home for referential
# integrity — never settles at the use site, and the record dies at
# generation.  The identical constraint attached at the bag spread
# instead (`&: $.schema.Order & {customerId: relate()}`) works, which is
# the workaround 10/domain.aontu ships.
# expected: {"customers":{"cust-1":{}},
#            "orders":{"ord-1":{"customerId":"cust-1","id":"ord-1"}}} exit 0
# actual:   [aontu/mapval_no_gen]: Cannot resolve value at path
#           $.orders.ord-1 (residue: type(close({"customerId":
#           relate()&re("^cust-"),"id":string}))&{...}) exit 1
schema: {
  Order: type(close({
    id: string
    customerId: relate() & path & re("^cust-")
  }))
}
customers: { "cust-1": id("cust-1") & { } }
orders: { &: $.schema.Order & { id: key() }, "ord-1": id("ord-1") & { customerId: "cust-1" } }
