# Shared include for refer-in-type-include.aontu (use-case 10 gap 7,
# claim C2, include half).  Same shape as refer-in-type-def.aontu, split
# so the schema crosses an @"..." boundary.
schema: {
  Order: type(close({
    id: string
    customerId: refer() & string & re("^cust-")
  }))
}
customers: {}
orders: { &: $.schema.Order & { id: key() } }
