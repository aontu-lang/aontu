# Use-case 10 gap 6 (claim C4, loud half): the same include+alias
# combination derails id(key(0)) — the key() argument never resolves
# and id() reports the unevaluated call itself as a bad entity name.
# Without the alias (ledgerId: integer inline in the include) the very
# same id(key(0)) spread works, and inline in one file it works too.
# expected: {"customers":{"c1":{"ledgerId":5}},"schema":{}} exit 0
# actual:   [aontu/id_name] "Cannot id value: id(key(0))" at
#           $.customers.c1, exit 1 (bogus error)
@"./alias-vocab.aon"
customers: { &: id(key(0)) & $.schema.C }
customers: c1: { ledgerId: 5 }
