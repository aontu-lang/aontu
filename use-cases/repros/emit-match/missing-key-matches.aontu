# §88 --- an emit rule's `match` admits a node the key is ABSENT from,
# where `filter`'s predicate over the same shape does not.
#
#   aontu -c missing-key-matches.aontu
#
# `rule` is what both ports answer: ["PK","PK"], the first rule taken
# for BOTH fields, though only the first field carries `pk`.
# `pick` is what `filter` answers over the same predicate: one field.
# The two mechanisms are the same question -- does this node satisfy
# this shape -- and must not answer it differently.

field: [{ n:"a" pk:true } { n:"b" }]

rule: emit($.field, [
  { match: { pk:true } body: ["PK"] }
  { match: { n:string } body: ["COL"] }
])

pick: filter($.field, { pk:true })
