# 87: a refusal site in the aontu:code vocabulary spells its nested
# aliases inline in TypeScript and by name in Go. The record's check
# list holds a shape no %check arm admits; both ports refuse it at
# $.aontu.Code.units.0.decls.0 as `empty`, with the same two sites, and the
# schema site's value differs.
#
# run: node ../../../ts/bin/aontu.js render --format json nested-alias-site-value.aontu
# run: aontu-go render --format json nested-alias-site-value.aontu
#
# expected: errors[0].sites[1].value identical in both ports
# actual:   TypeScript: {"check"?:[&:{"c":"min","exclusive":*false|boolean,"n":number}|...],...}
#           Go:         {"check"?:[&:%check],"doc"?:{...},...}
aontu: Code: units: [
  {
    path: "t.ts"
    lang: "typescript"
    decls: [
      {
        k: "record"
        name: "T"
        fields: [{ name:"a" type:{ k:"prim" prim:"string" } }]
        check: [{ k:"nope" }]
      }
    ]
  }
]
