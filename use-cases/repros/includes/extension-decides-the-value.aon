# 49: an included file's EXTENSION decides what the engine does with
# the bytes, and the two ports decide differently. The file content
# here is identical in vocab.json and vocab.jsonld; only the name
# differs.
#
# run: node ../../../ts/bin/aontu.js extension-decides-the-value.aon
# run: aontu-go extension-decides-the-value.aon
#
# FIXED 2026-08-30 (ADR-012). Both ports now answer
#   {"jsonld":{"@context":{"name":"http://schema.org/name"},"name":"Ada"}}
#
# `.jsonld` is on the read-as-Aontu list because JSON is a subset of
# the grammar. Before the ruling TypeScript handed every non-`.aon`
# file back as raw TEXT (ts/src/lang.ts, `processor: {aontu, aon}`,
# everything else falling through to multisource's default) while Go
# parsed everything as Aontu source (go/source.go's msOptions
# registering the empty kind, the fallback for an unrecognised
# extension) — so this file was a string in one port and a map in the
# other, both exiting 0.
#
# The durable pin is test/spec/file.tsv, load-ext-*.
jsonld: @"vocab.jsonld"
