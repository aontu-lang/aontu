# 85: a document included AS A VALUE (`g: @"./file.aontu"`) cannot be
# referenced into when the file declares an alias. The declaration is
# a key of the document, so under a value include it becomes `$.g.%x`,
# and the file's own `%x` references still look for `$.%x` at the
# including root -- which is not there -- so the subtree does not
# stand up and a path into it is no_path.
#
# run: node ../../../ts/bin/aontu.js --trust root value-include-declares-alias.aontu
# run: aontu-go --trust root value-include-declares-alias.aontu
#
# expected: {"g":{"code":{"units":[{"path":"a"}]},"y":1},"z":{"path":"a"}}
# actual:   no_path at $.z, in both ports. Remove the alias from the
#           included file (value-include-plain.aontu) and the same path
#           resolves.
g: @"./value-include-with-alias.aontu"
z: $.g.code.units.0
