# FIXED 2026-08-26 (the rank-uniform meet, ADR-004).
# expected: {"a":1.5,"b":2} -- a rank>=2 preference follows the same
#           meet rules as rank 1: a kind conjunct or kind alternative
#           the innermost value already satisfies leaves the ranked
#           preference standing, rank intact
# actual (now matches): {"a":1.5,"b":2}. Pinned by test/spec/pref.tsv
#         pref-rank2-conjunct-kind-keeps-default /
#         pref-rank2-disjunct-kind-keeps-default.
#         (Old behaviour: a:**1.5&float -> [aontu/mapval_no_gen] exit 1,
#         and b's default was silently dropped -- canon {"b":integer} --
#         because the gate read the immediate peg, a PrefVal whose
#         superior is top, so ANY conjunct overrode a ranked default.)
a: **1.5 & float
b: **2 | integer
b: integer
