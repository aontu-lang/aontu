# expected: 80 refused — it satisfies neither the default branch (8080)
#           nor the constraint branch (min 1024); this is the disjunct
#           spelling the docs' phase-1 note recommends over min(1024)&*8080
# actual: generates {"port":80} exit 0 — the same-kind override replaces
#         the pref and the constraint alternative is never consulted;
#         even `*8080 | (integer & neq(80))` admits port: 80
port: *8080 | (integer & min(1024) & max(65535))
port: 80
