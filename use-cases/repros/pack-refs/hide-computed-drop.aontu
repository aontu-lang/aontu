# Claim C5b (use-case 09 gap 4) -- FIXED 2026-08-26 by the
# template-clone isolation change (ADR-005): the copy()'d reference
# now DEFERS until the hide() wrapper has resolved at its own field,
# then clones with marks cleared as documented -- so docs carries the
# computed value ["|readonly"], the outcome the pack-free spelling
# always gave. Historically the reference cloned the pending hide
# call, the clone resolved at docs.0 and stamped its hide mark there,
# and the list silently skipped the marked element: exit 0, docs [],
# doc_row gone -- hide() converting a merge complication into silent
# data loss.
# Pinned in both engines: test/spec/marks.tsv hide-computed-pack-copy.
# expected: docs = ["|readonly"] exit 0
# actual:   docs = ["|readonly"] exit 0
names: [a]
tools: pack($.names, {})
tools: a: { se: readonly, doc_row: hide("|" + .se) }
docs: [ copy($.tools.a.doc_row) ]
