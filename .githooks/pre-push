#!/bin/sh
# The comment gate (DEV-PROCESS.md) runs before the push, not after CI
# is spent.
# Bypass with `git push --no-verify`; CI runs the same checker anyway.

set -e

REPO=$(git rev-parse --show-toplevel)

if ! command -v node >/dev/null 2>&1; then
	echo "pre-push: node is not on PATH, skipping the comment gate" >&2
	exit 0
fi

exec node "$REPO/admin/scripts/comment-gate.cjs"
